---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsultModal from '../components/ConsultModal.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  lang?: 'en' | 'id';
  directory?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang={props.lang ?? 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      Brand type (DESIGN.md): Space Grotesk for display, Inter for body.
      Served from Google Fonts with display=swap; the preconnects keep the
      handshake off the critical path. Follow-up: self-host both families via
      scripts/fetch-fonts.mjs to match the repo's font convention.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Space+Grotesk:wght@500..700&display=swap"
      rel="stylesheet"
    />

    <SEO {...props} />
  </head>

  <body class="bg-white text-brand-dark antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-2xl focus:border-2 focus:border-black focus:bg-brand-lime focus:px-4 focus:py-2 focus:font-display focus:text-xs focus:font-bold focus:uppercase focus:tracking-wider"
    >
      {props.lang === 'id' ? 'Lewati ke konten utama' : 'Skip to main content'}
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    {!props.directory && <ConsultModal />}
    <Analytics lang={props.lang} />
  </body>
</html>
