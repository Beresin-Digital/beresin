---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsultModal from '../components/ConsultModal.astro';
import Analytics from '../components/Analytics.astro';
import type { Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  lang?: 'en' | 'id';
  locale?: Locale;
  directory?: boolean;
}

const props = Astro.props;
// Pages pass `locale`; `lang` is kept as a fallback so older call sites keep
// rendering. New pages pass `locale` explicitly.
const locale: Locale = props.locale ?? props.lang ?? 'en';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      Preload only the face used by the LCP element (the hero heading).
      The mono font loads naturally — it is used on small labels only, and
      font-display: swap means neither font blocks first paint.
    */}
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-400-800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SEO {...props} lang={locale} />
  </head>

  <body class="bg-white text-brand-dark antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:border focus:border-black focus:bg-brand-lime focus:px-4 focus:py-2 focus:text-xs focus:font-black focus:uppercase focus:tracking-wider"
    >
      {locale === 'id' ? 'Lewati ke konten utama' : 'Skip to main content'}
    </a>

    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />
    {!props.directory && <ConsultModal locale={locale} />}
    <Analytics lang={locale} />
  </body>
</html>
