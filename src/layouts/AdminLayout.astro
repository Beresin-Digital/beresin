---
import '../styles/global.css';

/**
 * Admin document shell.
 *
 * Deliberately NOT BaseLayout: that pulls in Header, Footer, ConsultModal and
 * the site's JSON-LD, none of which belong in the admin area — and the modal
 * brings inline JavaScript this area does not need.
 *
 * There is no client JavaScript here at all. Every mutation is a plain
 * `<form method="post">` handled by an Astro Action, so the admin works with JS
 * disabled and stays cheap to render.
 *
 * Brand tokens are reused (lime chips, the hard shadow, the mono label face),
 * and the contrast rules from global.css are respected: lime appears only as a
 * background or as text on a dark surface, never as text on white.
 */
interface Props {
  title: string;
  /** 'bare' is the login screen: no sidebar, no logout form. */
  variant?: 'app' | 'bare';
  adminName?: string;
  /** Unread-lead count for the sidebar badge. */
  unread?: number;
}

const { title, variant = 'app', adminName = '', unread = 0 } = Astro.props;

const path = Astro.url.pathname;
const navItems = [{ href: '/admin/leads', label: 'Leads', badge: unread }];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- noindex layer 3 of 4: robots.txt, sitemap.xml.ts, this meta, and the
         X-Robots-Tag header set by middleware. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#0D0F12" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-brand-surface text-brand-dark antialiased">
    {
      variant === 'bare' ? (
        <main class="flex min-h-screen items-center justify-center px-4 py-12">
          <div class="w-full max-w-sm">
            <div class="mb-6 flex items-center gap-2">
              <span class="flex h-8 w-8 items-center justify-center rounded bg-brand-dark text-sm font-black text-brand-lime">
                B
              </span>
              <span class="font-display text-sm font-black uppercase tracking-tight text-brand-dark">
                Beresin <span class="rounded bg-black px-1.5 py-0.5 text-brand-lime">Admin</span>
              </span>
            </div>
            <slot />
          </div>
        </main>
      ) : (
        <div class="lg:grid lg:grid-cols-[15rem_1fr]">
          <aside class="bg-brand-dark text-white lg:min-h-screen">
            <div class="flex items-center gap-2 px-5 py-5">
              <span class="flex h-8 w-8 items-center justify-center rounded bg-brand-lime text-sm font-black text-black">
                B
              </span>
              <span class="font-display text-sm font-black uppercase tracking-tight text-white">
                Beresin <span class="rounded bg-brand-lime px-1.5 py-0.5 text-black">Admin</span>
              </span>
            </div>

            <nav aria-label="Navigasi admin" class="px-3 pb-4">
              <ul class="space-y-1">
                {navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'font-mono flex items-center justify-between rounded-lg px-3 py-2 text-[11px] font-extrabold uppercase tracking-widest transition-colors',
                        isActive(item.href)
                          ? 'bg-brand-lime text-black'
                          : 'text-gray-300 hover:bg-white/10 hover:text-white',
                      ]}
                    >
                      {item.label}
                      {item.badge > 0 && (
                        <span
                          class:list={[
                            'rounded px-1.5 py-0.5 text-[10px] font-black tabular-nums',
                            isActive(item.href) ? 'bg-black text-brand-lime' : 'bg-brand-lime text-black',
                          ]}
                        >
                          {item.badge > 99 ? '99+' : item.badge}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <div class="border-t border-white/10 px-3 py-4">
              <a
                href="/"
                class="font-mono flex items-center gap-2 rounded-lg px-3 py-2 text-[11px] font-extrabold uppercase tracking-widest text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
              >
                &larr; Kembali ke situs
              </a>
            </div>
          </aside>

          <div class="flex min-w-0 flex-col">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-black bg-white px-4 py-4 sm:px-6">
              <h1 class="font-display text-lg font-black uppercase tracking-tight text-brand-dark sm:text-xl">
                {title}
              </h1>

              <div class="flex items-center gap-3">
                {adminName && (
                  <span class="font-mono hidden text-[10px] font-extrabold uppercase tracking-widest text-gray-500 sm:inline">
                    {adminName}
                  </span>
                )}
                <form method="post" action="/admin/logout">
                  <button
                    type="submit"
                    class="font-mono rounded-lg border border-black bg-white px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-widest text-brand-dark transition-colors hover:bg-brand-lime"
                  >
                    Keluar
                  </button>
                </form>
              </div>
            </header>

            <main class="min-w-0 flex-1 px-4 py-6 sm:px-6">
              <slot />
            </main>
          </div>
        </div>
      )
    }
  </body>
</html>
