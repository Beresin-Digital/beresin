---
/**
 * Shared shell for the legal pages (/privacy-policy, /terms-and-conditions).
 *
 * Keeps the two documents visually identical and, more importantly, keeps the
 * heading order valid: the page <h1> comes from PageHeader, every section in
 * the body is an <h2>, and any sub-point is an <h3>.
 */
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead?: string;
  /** Human-readable date, e.g. "6 Oktober 2026". */
  updated: string;
}

const { title, description, eyebrow, heading, lead, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHeader eyebrow={eyebrow} title={heading} lead={lead} />

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="font-mono text-[11px] font-extrabold uppercase tracking-widest text-gray-500">
        Terakhir diperbarui: {updated}
      </p>
      <div class="legal-prose mt-8">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .legal-prose {
    font-size: 0.875rem;
    line-height: 1.75;
    color: #3f3f46;
  }
  .legal-prose h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-brand-dark);
  }
  .legal-prose h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-dark);
  }
  .legal-prose p {
    margin-bottom: 0.875rem;
  }
  .legal-prose ul {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal-prose li {
    margin-bottom: 0.375rem;
  }
  .legal-prose a {
    text-decoration: underline;
    color: var(--color-brand-dark);
  }
  .legal-prose strong {
    font-weight: 800;
    color: var(--color-brand-dark);
  }
  .legal-prose table {
    width: 100%;
    margin-bottom: 1.25rem;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .legal-prose th,
  .legal-prose td {
    border: 1px solid #e4e4e7;
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose th {
    background: var(--color-brand-surface);
    font-weight: 800;
    color: var(--color-brand-dark);
  }
</style>
