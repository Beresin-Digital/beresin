---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Principles from '../components/sections/Principles.astro';
import { Picture } from 'astro:assets';
import { ArrowUpRight, Phone } from '@lucide/astro';
import { images } from '../assets/images/manifest';
import { site, addressLine, whatsappLink } from '../data/site';
import { dicts } from '../i18n';

const d = dicts.id;

const title = 'Tentang Kami | Beresin Digital';
const description =
  'PT Beresin Urusan Digital adalah partner solusi digital dan pengembangan yang berbasis di Depok, Jawa Barat, yang membangun website, aplikasi mobile, aplikasi web kustom, solusi IoT, integrasi sistem, dan desain grafis untuk bisnis dan tim.';

/**
 * The company facts a prospective client or partner actually verifies. Kept as
 * data so the strip and any future JSON-LD stay in sync with `site.ts`.
 */
const facts = [
  { label: 'Badan hukum', value: site.legalName },
  { label: 'Alamat', value: addressLine('id') },
  {
    label: 'Email',
    value: site.emailProcurement,
    href: `mailto:${site.emailProcurement}`,
  },
  {
    label: 'WhatsApp',
    value: site.whatsappDisplay,
    href: whatsappLink(),
    external: true,
  },
] as const;
---

<BaseLayout title={title} description={description} locale="id">
  <PageHeader
    eyebrow="Tentang Kami"
    title="Solusi digital, dibangun sesuai bisnis Anda"
    lead="Partner solusi digital dan pengembangan. Kami membangun sistem yang memang dipakai setiap hari, bukan sekadar terlihat bagus di presentasi. Berikut ini apa yang kami pegang dan siapa yang kami layani."
  />

  <!-- Positioning. Deliberately not the homepage About block: that section is
       the teaser, this is the page, so the two must not be the same markup. -->
  <section class="border-b border-gray-200 bg-white py-16 text-brand-dark sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs font-extrabold uppercase tracking-widest">
            <span class="rounded border border-black bg-brand-lime px-3 py-1 text-black shadow-[2px_2px_0px_#0D0F12]">
              Siapa kami
            </span>
          </p>
          <h2
            class="font-display text-3xl font-black uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
          >
            Kami membangun solusi digital, bukan sekadar website.
          </h2>

          <div class="mt-5 space-y-4 text-sm font-medium leading-relaxed text-gray-700 sm:text-base">
            <p>
              PT Beresin Urusan Digital adalah partner solusi digital dan pengembangan yang berbasis di {site.address.city}, {d.site.region}. Kami membantu bisnis membangun dan mengembangkan kehadiran digital dan sistemnya, dari website dan aplikasi profesional sampai sistem kustom yang dibentuk mengikuti cara setiap bisnis benar-benar bekerja.
            </p>
            <p>
              Klien kami adalah perusahaan, yayasan pendidikan, dan agensi, tim yang membutuhkan sistemnya benar-benar dipakai sehari-hari, bukan sekadar lolos saat serah terima. Karena itu kami menempatkan pemetaan proses dan dokumentasi di depan, bukan di akhir.
            </p>
            <p>
              Kami juga bekerja sebagai partner pengembangan untuk agensi dan tim internal yang membutuhkan pengerjaan build, di bawah brand mereka atau brand kami. Kerja sama sering berlanjut melewati peluncuran, sebagai partner jangka panjang untuk roadmap, bukan vendor sekali jalan.
            </p>
          </div>

          <a
            href="/services"
            class="font-mono mt-7 inline-flex items-center gap-2 rounded-full border border-black bg-white px-5 py-3 text-xs font-extrabold uppercase tracking-wider text-brand-dark shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime"
          >
            Lihat layanan kami
            <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
          </a>
        </div>

        <div class="lg:col-span-6">
          <div class="overflow-hidden rounded-3xl border-2 border-black bg-white shadow-[8px_8px_0px_#0D0F12]">
            <Picture
              src={images.heroTeam.src}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 48vw, 90vw"
              alt={d.images.heroTeam}
              loading="lazy"
              decoding="async"
              class="aspect-[3/2] h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Principles locale="id" />

  <!-- Company facts. Kept compact: the four things someone actually checks
       before engaging a vendor. NPWP is intentionally absent — the owner chose
       not to publish it. -->
  <section class="border-b border-gray-200 bg-brand-surface py-16 text-brand-dark">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-black uppercase tracking-tight text-brand-dark sm:text-3xl">
        Detail perusahaan
      </h2>
      <p class="mt-3 max-w-2xl text-xs font-medium leading-relaxed text-gray-700 sm:text-sm">
        Detail yang biasanya diminta saat menggaet vendor atau partner.
      </p>

      <dl class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((fact) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-5">
              <dt class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
                {fact.label}
              </dt>
              <dd class="mt-2 text-sm font-extrabold leading-snug text-brand-dark [overflow-wrap:anywhere]">
                {fact.href ? (
                  <a
                    href={fact.href}
                    class="underline decoration-brand-lime decoration-2 underline-offset-2 hover:text-black"
                    target={'external' in fact && fact.external ? '_blank' : undefined}
                    rel={'external' in fact && fact.external ? 'noopener noreferrer' : undefined}
                  >
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="border-b border-black bg-brand-dark py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="font-mono mb-3 text-xs font-extrabold uppercase tracking-widest text-brand-lime">
            Langkah berikutnya
          </p>
          <h2
            class="font-display text-3xl font-black uppercase leading-none tracking-tight text-white sm:text-5xl"
          >
            Ingin tahu apakah cara kami bekerja cocok?
          </h2>
          <p class="mt-4 max-w-2xl text-sm font-medium leading-relaxed text-gray-300 sm:text-base">
            Ceritakan proyek atau masalah yang Anda hadapi. Kami akan sampaikan dengan jelas jika kami bukan pilihan yang tepat untuk kebutuhan Anda.
          </p>
        </div>

        <div class="flex flex-col gap-3 lg:col-span-4">
          <button
            type="button"
            data-open-modal={d.modalSubjects.discussProject}
            class="font-mono inline-flex items-center justify-center gap-2 rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#FFFFFF] transition-colors hover:bg-brand-lime-hover"
          >
            Konsultasi gratis
            <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
          </button>

          <a
            href={whatsappLink(d.waMessages.discussProject)}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-6 py-3.5 text-xs font-extrabold uppercase tracking-wider text-white transition-all hover:bg-white/20"
          >
            <Phone class="h-4 w-4" stroke-width={2.25} />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
