---
export const prerender = false;

import { actions, isInputError } from 'astro:actions';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ClientForm from '../../../components/admin/ClientForm.astro';
import { unreadCount } from '../../../lib/leads';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect('/admin/login');

const result = Astro.getActionResult(actions.saveClient);
if (result?.data) return Astro.redirect('/admin/clients');

const error = result?.error
  ? isInputError(result.error)
    ? 'Mohon periksa kembali isian formulir.'
    : result.error.message
  : null;

const unread = await unreadCount();
---

<AdminLayout title="Klien baru" adminName={admin.name} unread={unread}>
  <div class="mx-auto max-w-3xl">
    <ClientForm error={error} />
  </div>
</AdminLayout>
