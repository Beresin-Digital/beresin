---
import { Mail, MapPin, Clock, MessageCircle, Plus, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import FormStatus from '../components/FormStatus.astro';
import { site, whatsappLink, addressLine } from '../data/site';
import { responseSteps, procurementAssurances } from '../data/contact';
import { contactPage } from '../lib/seo';

const title = 'Kontak | Beresin Digital';
const description =
  'Hubungi Beresin Digital di Depok, Jawa Barat. Konsultasi gratis untuk pembuatan website, aplikasi custom, SIAKAD sekolah, portal pemerintah, sistem IoT & smart home, dan desain grafis.';

const pageUrl = `${site.url}/kontak`;

/**
 * Two links out to the same place, on purpose: the text link opens the Maps
 * app (the right choice on a phone, which is where most people will be), while
 * the embed below stays unloaded until the visitor asks for it. No iframe is
 * fetched on page load — a third-party map that boots on arrival is the single
 * heaviest thing this page could carry, and it would set Google cookies before
 * the visitor has interacted with anything.
 */
const mapsQuery = encodeURIComponent(`${site.legalName}, ${addressLine()}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const mapsEmbedUrl = `https://www.google.com/maps?q=${mapsQuery}&output=embed`;

const channels = [
  {
    icon: MessageCircle,
    label: 'WhatsApp',
    value: site.whatsappDisplay,
    href: whatsappLink('Halo Beresin Digital, saya ingin berkonsultasi soal proyek digital.'),
    external: true,
    note: 'Cara tercepat, cocok untuk pertanyaan singkat atau diskusi awal.',
  },
  {
    icon: Mail,
    label: 'Email',
    value: site.emailProcurement,
    href: `mailto:${site.emailProcurement}`,
    external: false,
    note: 'Untuk penawaran, dokumen pengadaan, dan korespondensi resmi.',
  },
  {
    icon: Clock,
    label: 'Jam Operasional',
    value: site.openingHoursDisplay,
    href: null,
    external: false,
    note: 'Pesan yang masuk di luar jam kerja kami balas pada hari kerja berikutnya.',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={[contactPage({ url: pageUrl })]}>
  <PageHeader
    eyebrow="Kontak"
    title="Mari bicara soal proyek Anda"
    lead="Ceritakan kebutuhan Anda. Kami balas dalam 1×24 jam kerja dengan estimasi ruang lingkup, waktu, dan opsi teknologi."
  />

  <FormStatus />

  <!-- Channels + form. The form is the point of the page, so it takes the wider
       column on desktop while the channels stay narrow beside it. -->
  <section id="kanal" class="border-b border-gray-200 bg-brand-surface py-16 text-brand-dark sm:py-20">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-12 lg:px-8">
      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl font-black uppercase tracking-tight text-brand-dark sm:text-3xl">
          Kanal resmi
        </h2>
        <p class="mt-2 text-xs font-medium leading-relaxed text-gray-600 sm:text-sm">
          Untuk keperluan pengadaan, penawaran, dan korespondensi resmi, gunakan kanal di bawah ini.
        </p>

        <ul class="mt-6 space-y-3">
          {
            channels.map(({ icon: Icon, label, value, href, external, note }) => (
              <li class="flex items-start gap-3 rounded-2xl border border-gray-200 bg-white p-4">
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-black bg-brand-lime text-black">
                  <Icon class="h-4 w-4" stroke-width={2.25} />
                </span>
                <div class="min-w-0">
                  <p class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-500">
                    {label}
                  </p>
                  {href ? (
                    <a
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="mt-0.5 block break-words text-sm font-extrabold text-brand-dark underline decoration-brand-lime decoration-2 underline-offset-2 hover:text-black"
                    >
                      {value}
                    </a>
                  ) : (
                    <p class="mt-0.5 text-sm font-extrabold text-brand-dark">{value}</p>
                  )}
                  <p class="mt-1.5 text-[11px] font-medium leading-relaxed text-gray-600">{note}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <address class="mt-6 font-mono text-[11px] not-italic leading-relaxed text-gray-600">
          {site.legalName}
        </address>
      </div>

      <div class="lg:col-span-3">
        <div class="rounded-3xl border-2 border-black bg-white p-6 shadow-[6px_6px_0px_#0D0F12] sm:p-8">
          <h2 class="font-display text-2xl font-black uppercase tracking-tight text-brand-dark">
            Kirim brief proyek
          </h2>
          <p class="mt-1 text-xs font-medium text-gray-600">
            Kolom bertanda wajib harus diisi. Data Anda diproses sesuai Kebijakan Privasi kami.
          </p>
          <div class="mt-6">
            <ContactForm idPrefix="page" source="kontak-page" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sets the expectation for what happens after the form is sent. Every line
       restates the 1×24 jam kerja promise already made in the page lead. -->
  <section id="alur" class="border-b border-gray-200 bg-white py-16 text-brand-dark sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs font-extrabold uppercase tracking-widest">
          <span class="rounded border border-black bg-brand-lime px-3 py-1 text-black shadow-[2px_2px_0px_#0D0F12]">
            Setelah Anda kirim
          </span>
        </p>
        <h2
          class="font-display text-3xl font-black uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
        >
          Apa yang terjadi selanjutnya.
        </h2>
        <p class="mt-4 text-sm font-medium leading-relaxed text-gray-700 sm:text-base">
          Tidak ada brief yang hilang di kotak masuk. Alurnya seperti ini.
        </p>
      </div>

      <ol class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-3">
        {
          responseSteps.map((step, i) => (
            <li class="border-t-2 border-black pt-5">
              <span
                class="font-display text-3xl font-black tabular-nums leading-none text-gray-500"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display mt-3 text-base font-black uppercase leading-snug tracking-tight text-brand-dark">
                {step.title}
              </h3>
              <p class="mt-2 text-xs font-medium leading-relaxed text-gray-700 sm:text-sm">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Location. The map is a <details> so the iframe is not fetched until the
       visitor opens it — a lazy iframe inside a closed <details> is never
       rendered, so no request goes out and no third-party cookie is set. -->
  <section id="lokasi" class="border-b border-gray-200 bg-brand-surface py-16 text-brand-dark sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs font-extrabold uppercase tracking-widest">
            <span class="rounded border border-black bg-brand-lime px-3 py-1 text-black shadow-[2px_2px_0px_#0D0F12]">
              Lokasi
            </span>
          </p>
          <h2
            class="font-display text-3xl font-black uppercase leading-none tracking-tight text-brand-dark sm:text-4xl"
          >
            Kantor kami di {site.address.city}.
          </h2>

          <address
            class="mt-6 rounded-2xl border border-gray-200 bg-white p-5 not-italic [overflow-wrap:anywhere]"
          >
            <p class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
              Alamat
            </p>
            <p class="mt-2 text-sm font-extrabold leading-snug text-brand-dark">
              {site.legalName}
            </p>
            <p class="mt-1 text-sm font-medium leading-relaxed text-gray-700">
              {addressLine()}
            </p>
          </address>

          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono mt-5 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-brand-dark underline decoration-brand-lime decoration-2 underline-offset-4 hover:text-black"
          >
            <MapPin class="h-4 w-4" stroke-width={2.5} />
            Buka di Google Maps
          </a>
        </div>

        <div class="lg:col-span-7">
          <details class="group">
            <summary
              class="flex cursor-pointer items-center justify-between gap-4 rounded-2xl border-2 border-black bg-white px-5 py-4 shadow-[4px_4px_0px_#0D0F12] transition-colors hover:bg-brand-lime/40"
            >
              <span class="flex items-center gap-3">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-black bg-brand-lime text-black"
                  aria-hidden="true"
                >
                  <MapPin class="h-4 w-4" stroke-width={2.25} />
                </span>
                <span class="min-w-0">
                  <span
                    class="font-display block text-sm font-black uppercase tracking-tight text-brand-dark"
                  >
                    Tampilkan peta
                  </span>
                  <span
                    class="font-mono mt-0.5 block text-[10px] uppercase tracking-widest text-gray-600"
                  >
                    Dimuat dari Google Maps saat dibuka
                  </span>
                </span>
              </span>
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-black bg-white text-brand-dark transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <Plus class="h-4 w-4" stroke-width={2.5} />
              </span>
            </summary>

            <div
              class="mt-4 aspect-[16/10] overflow-hidden rounded-2xl border-2 border-black bg-white sm:aspect-[16/9]"
            >
              <iframe
                src={mapsEmbedUrl}
                title={`Peta lokasi kantor ${site.legalName}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-full w-full border-0"></iframe>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Procurement closing. Every fact here already lives in faq.ts or site.ts;
       this is where an instansi officer lands, so it is worth surfacing before
       they leave for /layanan. -->
  <section id="pengadaan" class="border-b border-black bg-brand-dark py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="font-mono mb-3 text-xs font-extrabold uppercase tracking-widest text-brand-lime">
            Pengadaan
          </p>
          <h2
            class="font-display text-3xl font-black uppercase leading-none tracking-tight text-white sm:text-4xl"
          >
            Untuk instansi &amp; pengadaan.
          </h2>
          <p class="mt-4 text-sm font-medium leading-relaxed text-gray-300 sm:text-base">
            Hal-hal yang biasanya diminta sebelum vendor dimasukkan ke daftar rekanan. Kalau ada
            dokumen lain yang Anda butuhkan, sebutkan saja.
          </p>

          <a
            href="/layanan#faq"
            class="font-mono mt-6 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-brand-lime underline decoration-brand-lime decoration-2 underline-offset-4 hover:text-white"
          >
            Lihat FAQ pengadaan lengkap
            <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
          </a>
        </div>

        <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-8">
          {
            procurementAssurances.map((item) => (
              <div class="border-t-2 border-white/20 pt-4">
                <dt class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-brand-lime">
                  {item.label}
                </dt>
                <dd class="mt-2 text-xs font-medium leading-relaxed text-gray-300 sm:text-sm">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
