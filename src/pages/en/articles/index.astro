---
export const prerender = false;

/**
 * Articles index.
 *
 * Server-rendered against the `articles` table: published rows, newest first.
 * An empty table falls back to the same "no articles yet" panel the page had
 * before the CMS existed, so the route is never a blank shell.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ContentImage from '../../../components/ContentImage.astro';
import { listPublishedArticles } from '../../../lib/articles';
import { formatDate, isoDate, readingMinutes } from '../../../lib/format';
import { breadcrumbs, itemList } from '../../../lib/seo';
import { site } from '../../../data/site';
import { dicts } from '../../../i18n';

const d = dicts.en;

const articles = await listPublishedArticles('en');

const title = 'Articles & Digital Insight | Beresin Digital';
const description =
  'Practical notes and guides on web development, custom applications, system integration, IoT, and building digital solutions for businesses.';

const pageUrl = `${site.url}/en/articles`;

const jsonLd = [
  breadcrumbs([
    { name: 'Home', url: `${site.url}/` },
    { name: 'Articles', url: pageUrl },
  ]),
  articles.length > 0
    ? itemList({
        url: pageUrl,
        name: 'Articles & Digital Insight',
        items: articles.map((article) => ({
          url: `${site.url}/en/articles/${article.slug}`,
          name: article.title,
        })),
      })
    : undefined,
];

const publishedOn = (article: (typeof articles)[number]) => article.publishedAt ?? article.createdAt;
const hasCover = (article: (typeof articles)[number]) =>
  Boolean(article.coverImage && article.coverWidth && article.coverHeight);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} locale="en">
  <PageHeader
    eyebrow="Articles"
    title="Practical notes & guides"
    lead="Short pieces on building digital products, custom systems, integrations, and design — written by the Beresin Digital team."
  />

  <section class="border-b border-gray-200 bg-white py-16 text-brand-dark sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {
        articles.length === 0 ? (
          <div class="mx-auto max-w-3xl">
            <div class="rounded-3xl border-2 border-dashed border-gray-300 bg-brand-surface px-6 py-14 text-center sm:px-10">
              <span class="font-mono inline-block rounded border border-black bg-brand-lime px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-black">
                Coming soon
              </span>
              <h2 class="font-display mt-5 text-2xl font-black uppercase tracking-tight text-brand-dark sm:text-3xl">
                No articles published yet
              </h2>
              <p class="mx-auto mt-3 max-w-md text-xs font-medium leading-relaxed text-gray-600 sm:text-sm">
                We are preparing the first pieces. In the meantime, if you have a specific question
                about a digital project, the team is ready to help directly.
              </p>
              <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
                <button
                  type="button"
                  data-open-modal={d.modalSubjects.askArticles}
                  class="font-mono rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
                >
                  Ask us directly
                </button>
                <a
                  href="/en/services"
                  class="font-mono rounded-full border border-black bg-white px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-gray-50"
                >
                  View Services
                </a>
              </div>
            </div>
          </div>
        ) : (
          <>
            <!-- The page h1 already names this list; the sr-only heading keeps
                 the outline h1 → h2 → h3 (the cards are h3). -->
            <h2 class="sr-only">Article list</h2>
            <!-- Masonry via CSS multi-column. A grid row is as tall as its
                 tallest card, so the text-only articles leave a gap under them;
                 multi-column lets each card keep its natural height and pack
                 tightly, which is the whole point. No JS.
                 Trade-off: multi-column fills top-to-bottom, so the newest
                 article is at the top of column one and the order runs down it
                 (column-major) rather than left-to-right — the normal reading
                 order for a masonry wall. -->
            <div class="columns-1 gap-8 sm:columns-2 lg:columns-3">
              {articles.map((article) => (
                <article class="group mb-8 flex break-inside-avoid flex-col overflow-hidden rounded-3xl border-2 border-black bg-white shadow-[6px_6px_0px_#0D0F12] transition-transform duration-300 hover:-translate-y-1">
                  <a href={`/en/articles/${article.slug}`} class="flex flex-1 flex-col">
                    {hasCover(article) && (
                      <div class="relative overflow-hidden border-b-2 border-black">
                        <ContentImage
                          src={article.coverImage!}
                          alt={article.coverAlt}
                          width={article.coverWidth!}
                          height={article.coverHeight!}
                          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 90vw"
                          class="h-auto max-h-[26rem] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        <span class="font-mono absolute left-4 top-4 rounded border border-black bg-brand-lime px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-black shadow-[2px_2px_0px_#0D0F12]">
                          {article.category}
                        </span>
                      </div>
                    )}

                    <div class="flex flex-1 flex-col p-6">
                      {!hasCover(article) && (
                        <p class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
                          {article.category}
                        </p>
                      )}
                      <h3 class="font-display mt-2 text-xl font-black uppercase leading-tight tracking-tight text-brand-dark decoration-brand-lime decoration-4 underline-offset-4 group-hover:underline">
                        {article.title}
                      </h3>
                      <p class="mt-3 text-xs font-medium leading-relaxed text-gray-600">
                        {article.excerpt}
                      </p>
                      <p class="font-mono mt-auto pt-5 text-[10px] font-bold uppercase tracking-wider text-gray-500">
                        <time datetime={isoDate(publishedOn(article))}>
                          {formatDate(publishedOn(article), 'en')}
                        </time>
                        <span aria-hidden="true"> &middot; </span>
                        {readingMinutes(article.body)} {d.articlesSection.minRead}
                      </p>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
