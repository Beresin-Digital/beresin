---
export const prerender = false;

/**
 * English 404 route.
 *
 * Exists so the English article-detail route has a real route to rewrite to
 * (`Astro.rewrite('/en/404')`) on an unknown or unpublished slug. The body
 * is shared with the root 404 page; only the locale is fixed to English here.
 * No hreflang links — the requested path is not a real page in either locale.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';

const title = 'Page Not Found | Beresin Digital';
const description =
  'The page you are looking for could not be found. Return to the homepage or contact the Beresin Digital team.';
---

<BaseLayout title={title} description={description} noindex locale="en" hreflang={false}>
  <NotFoundContent locale="en" />
</BaseLayout>
