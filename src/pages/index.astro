---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/sections/Marquee.astro';
import Services from '../components/sections/Services.astro';
import Clients from '../components/sections/Clients.astro';
import About from '../components/sections/About.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import Partnership from '../components/sections/Partnership.astro';
import Articles from '../components/sections/Articles.astro';
import FormStatus from '../components/FormStatus.astro';
import PortfolioModal from '../components/PortfolioModal.astro';
import { listPublishedArticles } from '../lib/articles';
import { listActiveClients } from '../lib/clients';
import { listPublishedProjects } from '../lib/projects';

// Server-rendered so a publish in the admin appears immediately. The DB is only
// touched at request time, so `pnpm build` still needs no database.
const [articles, clients, projects] = await Promise.all([
  listPublishedArticles(),
  listActiveClients(),
  listPublishedProjects(),
]);

const title = 'Digital Solutions & Development Partner | Beresin Digital';
const description =
  'Beresin Digital is a digital solutions and development partner. We design and build websites, mobile apps, custom web applications, IoT solutions, system integrations, and graphic design for businesses.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <Marquee />
  <FormStatus />
  <Services />
  <Clients clients={clients} />
  <About />
  <Portfolio projects={projects} />
  <WhyChooseUs />
  <Partnership />
  <Articles articles={articles} />
  <PortfolioModal projects={projects} />
</BaseLayout>

