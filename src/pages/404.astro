---
export const prerender = false;

/**
 * Site 404 page.
 *
 * On-demand (`prerender = false`) rather than static on purpose: the article
 * detail route is server-rendered and, on an unknown or unpublished slug, does
 * `Astro.rewrite('/404')` (or `'/en/404'` for English) to reuse this page.
 * Astro forbids rewriting an on-demand route to a *prerendered* one
 * (`ForbiddenRewrite`), because the prerendered page is compiled to an HTML file
 * that is not retrievable at runtime. Keeping this route on-demand makes the
 * rewrite legal, and the Node adapter still serves it for every unmatched path.
 *
 * The locale comes from the requested path: an unmatched `/en/*` URL renders
 * the English version, everything else the Indonesian one. No hreflang links
 * here — the requested path is not a real page in either locale.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFoundContent from '../components/NotFoundContent.astro';
import { localeFromPath } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const title =
  locale === 'id'
    ? 'Halaman Tidak Ditemukan | Beresin Digital'
    : 'Page Not Found | Beresin Digital';
const description =
  locale === 'id'
    ? 'Halaman yang Anda cari tidak dapat ditemukan. Kembali ke beranda atau hubungi tim Beresin Digital.'
    : 'The page you are looking for could not be found. Return to the homepage or contact the Beresin Digital team.';
---

<BaseLayout title={title} description={description} noindex locale={locale} hreflang={false}>
  <NotFoundContent locale={locale} />
</BaseLayout>
