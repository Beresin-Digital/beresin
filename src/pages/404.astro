---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = 'Halaman Tidak Ditemukan | Beresin Digital';
const description =
  'Halaman yang Anda cari tidak ditemukan. Kembali ke beranda atau hubungi tim Beresin Digital.';

const quickLinks = [
  { label: 'Beranda', href: '/' },
  { label: 'Layanan', href: '/layanan' },
  { label: 'Tentang Kami', href: '/tentang' },
  { label: 'Artikel', href: '/artikel' },
  { label: 'Kontak', href: '/kontak' },
];
---

<BaseLayout title={title} description={description} noindex>
  <section class="bg-grid-light border-b border-gray-200 bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <p
        class="inline-flex items-center gap-2 rounded border border-black bg-brand-lime px-3 py-1 font-mono text-xs font-extrabold uppercase tracking-widest text-black shadow-[2px_2px_0px_#0D0F12]"
      >
        Error 404
      </p>
      <h1
        class="font-display mt-6 text-5xl font-black uppercase leading-none tracking-tighter text-brand-dark sm:text-7xl"
      >
        Halaman tidak ditemukan
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-sm font-semibold leading-relaxed text-gray-700 sm:text-base">
        Tautan yang Anda buka mungkin sudah dipindahkan atau tidak pernah ada. Silakan kembali ke
        beranda, atau hubungi kami langsung bila Anda mencari informasi tertentu.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="font-mono rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
        >
          Kembali ke Beranda
        </a>
        <button
          type="button"
          data-open-modal="Konsultasi Proyek"
          class="font-mono rounded-full border border-black bg-white px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-gray-50"
        >
          Hubungi Kami
        </button>
      </div>

      <nav class="mt-10" aria-label="Tautan cepat">
        <p class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-500">
          Tautan cepat
        </p>
        <ul class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs font-extrabold uppercase tracking-wide text-gray-600 underline-offset-4 hover:text-black hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="mt-10 font-mono text-[11px] text-gray-400">
        {site.legalName} — {site.address.city}, {site.address.countryName}
      </p>
    </div>
  </section>
</BaseLayout>
