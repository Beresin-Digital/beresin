---
export const prerender = false;

/**
 * Site 404 page.
 *
 * On-demand (`prerender = false`) rather than static on purpose: the article
 * detail route is server-rendered and, on an unknown or unpublished slug, does
 * `Astro.rewrite('/404')` to reuse this page. Astro forbids rewriting an
 * on-demand route to a *prerendered* one (`ForbiddenRewrite`), because the
 * prerendered page is compiled to an HTML file that is not retrievable at
 * runtime. Keeping this route on-demand makes the rewrite legal, and the Node
 * adapter still serves it for every unmatched path.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = 'Page Not Found | Beresin Digital';
const description =
  'The page you are looking for could not be found. Return to the homepage or contact the Beresin Digital team.';

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Articles', href: '/articles' },
  { label: 'Contact', href: '/contact' },
];
---

<BaseLayout title={title} description={description} noindex>
  <section class="bg-grid-light border-b border-gray-200 bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <p
        class="inline-flex items-center gap-2 rounded border border-black bg-brand-lime px-3 py-1 font-mono text-xs font-extrabold uppercase tracking-widest text-black shadow-[2px_2px_0px_#0D0F12]"
      >
        Error 404
      </p>
      <h1
        class="font-display mt-6 text-5xl font-black uppercase leading-none tracking-tighter text-brand-dark sm:text-7xl"
      >
        Page not found
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-sm font-semibold leading-relaxed text-gray-700 sm:text-base">
        The link you followed may have been moved or may never have existed. Head back to the
        homepage, or contact us directly if you are looking for something specific.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="font-mono rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
        >
          Back to Home
        </a>
        <button
          type="button"
          data-open-modal="Discuss Your Project"
          class="font-mono rounded-full border border-black bg-white px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-gray-50"
        >
          Contact Us
        </button>
      </div>

      <nav class="mt-10" aria-label="Quick links">
        <p class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-500">
          Quick links
        </p>
        <ul class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs font-extrabold uppercase tracking-wide text-gray-600 underline-offset-4 hover:text-black hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="mt-10 font-mono text-[11px] text-gray-400">
        {site.legalName} — {site.address.city}, {site.address.countryName}
      </p>
    </div>
  </section>
</BaseLayout>
