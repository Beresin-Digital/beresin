---
import DirectoryLayout from '../../../../../layouts/DirectoryLayout.astro';
import SchoolListing from '../../../../../components/directory/SchoolListing.astro';
import { schools, regencies, DIRECTORY_PAGE_SIZE, regionPath, listingPath } from '../../../../../lib/directory/data';
import { itemList } from '../../../../../lib/seo';
import { site } from '../../../../../data/site';
export function getStaticPaths() {
  return regencies.flatMap(regency => {
    const count = schools.filter(school => school.provinceSlug === regency.provinceSlug && school.regencySlug === regency.slug).length;
    return Array.from({ length: Math.max(0, Math.ceil(count / DIRECTORY_PAGE_SIZE) - 1) }, (_, i) => ({ params: { provinsi: regency.provinceSlug, kabupaten: regency.slug, page: String(i + 2) }, props: { regency, page: i + 2 } }));
  });
}
const { regency, page } = Astro.props;
const records = schools.filter(school => school.provinceSlug === regency.provinceSlug && school.regencySlug === regency.slug);
const path = listingPath(regency.provinceSlug, regency.slug, page);
const description = `Halaman ${page} daftar sekolah dan lembaga pendidikan di ${regency.name}, ${regency.province}. Buka profil, telusuri alamat, atau cari sekolah di seluruh wilayah.`;
const jsonLd = [itemList({ url: site.url + path, name: `Sekolah di ${regency.name} - halaman ${page}`, items: records.slice((page - 1) * DIRECTORY_PAGE_SIZE, page * DIRECTORY_PAGE_SIZE).map(school => ({ name: school.name, url: site.url + school.path })) })];
---
<DirectoryLayout title={`Sekolah di ${regency.name} - Halaman ${page}`} description={description} crumbs={[{ name: regency.province, path: regionPath(regency.provinceSlug) }, { name: regency.name, path: regionPath(regency.provinceSlug, regency.slug) }, { name: `Halaman ${page}`, path }]} jsonLd={jsonLd} event="region_view" province={regency.province} regency={regency.name}>
  <h1 class="directory-heading">Sekolah di {regency.name}<span class="mt-3 block text-2xl font-bold tracking-normal">Halaman {page}</span></h1>
  <p class="directory-copy mt-3">{records.length} sekolah dan lembaga · {regency.province}. Pencarian mencakup seluruh data wilayah ini.</p>
  <SchoolListing schools={records} page={page} provinceSlug={regency.provinceSlug} regencySlug={regency.slug} />
</DirectoryLayout>
