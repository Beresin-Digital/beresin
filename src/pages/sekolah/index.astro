---
import DirectoryLayout from '../../layouts/DirectoryLayout.astro';
import DirectorySearch from '../../components/directory/DirectorySearch.astro';
import { schools, provinces, regencies, regionPath } from '../../lib/directory/data';
import { itemList } from '../../lib/seo';
import { site } from '../../data/site';
const title = 'Direktori Sekolah';
const description = `Cari ${schools.length} sekolah dan lembaga pendidikan dari wilayah yang tersedia. Temukan identitas, alamat, dan kontak dalam direktori yang dikelola Beresin Digital.`;
const jsonLd = [itemList({ url: `${site.url}/sekolah`, name: 'Wilayah direktori sekolah', items: regencies.map(region => ({ name: `${region.name}, ${region.province}`, url: site.url + regionPath(region.provinceSlug, region.slug) })) })];
---
<DirectoryLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="grid gap-6 pt-4 sm:pt-6 lg:grid-cols-[2fr_1fr] lg:items-end lg:gap-12">
    <div>
      <h1 class="directory-heading directory-landing-heading">Cari sekolah dan<br class="hidden sm:block" /> lembaga pendidikan.</h1>
      <p class="directory-copy mt-4">Temukan identitas, lokasi, dan kontak sekolah. Cari berdasarkan nama atau NPSN, lalu saring menurut bentuk pendidikan dan wilayah.</p>
      <DirectorySearch />
    </div>
    <aside data-directory-coverage class="border-l-2 border-brand-border pl-5">
      <p class="text-base font-bold">{schools.length.toLocaleString('id-ID')} sekolah dan lembaga pendidikan</p>
      <p class="mt-2 text-sm leading-relaxed text-brand-muted">{regencies.length} kabupaten/kota di {provinces.map(province => province.name).join(' dan ')}.</p>
      <a href="/sekolah/tentang-data" class="mt-1 inline-flex min-h-11 items-center text-sm font-bold underline">Cakupan dan sumber data</a>
    </aside>
  </div>
  <section class="mt-10 sm:mt-12" aria-labelledby="region-heading">
    <h2 id="region-heading" class="directory-section-heading">Jelajahi berdasarkan wilayah</h2>
    <ul class="divide-y divide-gray-200 border-y border-gray-200">
      {regencies.map(region => <li><a href={regionPath(region.provinceSlug, region.slug)} class="flex min-h-20 flex-wrap items-center justify-between gap-3 py-6 text-xl font-extrabold underline"><span>{region.name}<span class="mt-2 block text-sm font-medium text-gray-600">{region.province}</span></span><span class="text-sm font-medium text-gray-600">{schools.filter(school => school.provinceSlug === region.provinceSlug && school.regencySlug === region.slug).length} sekolah dan lembaga</span></a></li>)}
    </ul>
  </section>
  <section class="mt-10 border-t border-brand-border pt-6 sm:flex sm:items-center sm:justify-between sm:gap-8">
    <div>
      <h2 class="mb-2 text-xl font-extrabold">Website untuk sekolahmu</h2>
      <p class="directory-copy">Kenali layanan Beresin Digital untuk kebutuhan website sekolah.</p>
    </div>
    <a href="/services" data-directory-click="directory_service_click" class="mt-3 inline-flex min-h-11 shrink-0 items-center text-sm font-bold underline sm:mt-0">Lihat layanan Beresin Digital</a>
  </section>
</DirectoryLayout>
