---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceDetail from '../components/sections/ServiceDetail.astro';
import Process from '../components/sections/Process.astro';
import Faq from '../components/sections/Faq.astro';
import { ArrowUpRight, Mail } from '@lucide/astro';
import { services } from '../data/services';
import { faqItems } from '../data/faq';
import { site } from '../data/site';
import { dicts } from '../i18n';
import { faqPage, serviceCatalog } from '../lib/seo';

const d = dicts.id;

const title = 'Layanan — Website, Aplikasi Mobile, IoT & Desain | Beresin Digital';
const description =
  'Layanan Beresin Digital: pengembangan website dan aplikasi mobile, solusi IoT, integrasi sistem, dan desain grafis (UI/UX dan branding), beserta proses kami dan jawaban atas pertanyaan umum.';

const pageUrl = `${site.url}/services`;

/**
 * Structured data for this page: the four services as `Service` nodes behind an
 * `ItemList`, plus a `FAQPage` mirroring the visible accordion below.
 */
const jsonLd = [
  ...serviceCatalog({
    url: pageUrl,
    services: services.id.map((s) => ({ id: s.id, title: s.title, description: s.description })),
  }),
  faqPage(faqItems.id),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} locale="id">
  <PageHeader
    eyebrow="Layanan"
    title="Apa yang kami kerjakan"
    lead="Keempat layanan kami, dijabarkan sampai detail, apa yang Anda terima, untuk siapa masing-masing layanan, dan bagaimana proses berjalan dari percakapan pertama sampai sistem tayang."
  >
    <!-- Jump nav. Plain anchors, no JavaScript — the service sections carry the
         matching ids and inherit `scroll-margin-top` from global.css. -->
    <nav aria-label="Loncat ke layanan" class="mt-8 flex flex-wrap gap-2">
      {
        services.id.map((service, i) => (
          <a
            href={`#${service.id}`}
            class="font-mono inline-flex items-center gap-2 rounded-full border border-black bg-white px-4 py-2 text-[11px] font-extrabold uppercase tracking-wider text-brand-dark shadow-[2px_2px_0px_#0D0F12] transition-colors hover:bg-brand-lime"
          >
            <span class="tabular-nums text-gray-600" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {service.title}
          </a>
        ))
      }
    </nav>
  </PageHeader>

  {services.id.map((service, i) => <ServiceDetail service={service} index={i} locale="id" />)}

  <Process locale="id" />
  <Faq locale="id" />

  <!-- Closing CTA. Dark, to echo the homepage Services band and give the page a
       definite end. Deliberately not the old "Punya kebutuhan yang belum
       tercantum?" copy — this is a next step, not a repeat of the pitch. -->
  <section class="border-b border-black bg-brand-dark py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="font-mono mb-3 text-xs font-extrabold uppercase tracking-widest text-brand-lime">
            Langkah berikutnya
          </p>
          <h2
            class="font-display text-3xl font-black uppercase leading-none tracking-tight text-white sm:text-5xl"
          >
            Belum yakin harus mulai dari mana?
          </h2>
          <p class="mt-4 max-w-2xl text-sm font-medium leading-relaxed text-gray-300 sm:text-base">
            Ceritakan posisi Anda hari ini. Kami akan membantu menentukan layanan yang paling relevan, ruang lingkupnya, dan langkah pertamanya, tanpa biaya dan tanpa komitmen.
          </p>
        </div>

        <div class="flex flex-col gap-3 lg:col-span-4">
          <button
            type="button"
            data-open-modal={d.modalSubjects.serviceConsultation}
            class="font-mono inline-flex items-center justify-center gap-2 rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#FFFFFF] transition-colors hover:bg-brand-lime-hover"
          >
            Konsultasi gratis
            <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
          </button>

          <a
            href={`mailto:${site.emailProcurement}`}
            class="font-mono inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-6 py-3.5 text-xs font-extrabold uppercase tracking-wider text-white transition-all hover:bg-white/20"
          >
            <Mail class="h-4 w-4" stroke-width={2.25} />
            Email kami
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
