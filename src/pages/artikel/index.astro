---
/**
 * ⚠️ PHASE 1 PLACEHOLDER.
 *
 * This page is prerendered and intentionally static — there is no article store
 * yet. Phase 4 replaces this file entirely with a DB-driven index that reads
 * published rows from the `articles` table, adds pagination, and emits
 * ItemList JSON-LD. The route, the heading order, and the empty state below are
 * already shaped for that swap.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const title = 'Artikel & Insight Digital | Beresin Digital';
const description =
  'Catatan dan panduan praktis seputar pengembangan website, aplikasi custom, SIAKAD sekolah, digitalisasi instansi pemerintah, dan desain grafis.';
---

<BaseLayout title={title} description={description}>
  <PageHeader
    eyebrow="Artikel"
    title="Catatan & panduan praktis"
    lead="Tulisan singkat seputar pengembangan produk digital, sistem akademik, digitalisasi instansi, dan desain — ditulis oleh tim Beresin Digital."
  />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <div
        class="rounded-3xl border-2 border-dashed border-gray-300 bg-brand-surface px-6 py-14 sm:px-10"
      >
        <span
          class="font-mono inline-block rounded border border-black bg-brand-lime px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-black"
        >
          Segera hadir
        </span>
        <h2
          class="font-display mt-5 text-2xl font-black uppercase tracking-tight text-brand-dark sm:text-3xl"
        >
          Belum ada artikel yang dipublikasikan
        </h2>
        <p class="mx-auto mt-3 max-w-md text-xs font-medium leading-relaxed text-gray-600 sm:text-sm">
          Kami sedang menyiapkan tulisan pertama. Sementara itu, bila Anda punya pertanyaan spesifik
          soal proyek digital, tim kami siap membantu langsung.
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            data-open-modal="Pertanyaan Artikel"
            class="font-mono rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
          >
            Tanya Langsung
          </button>
          <a
            href="/layanan"
            class="font-mono rounded-full border border-black bg-white px-6 py-3.5 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-gray-50"
          >
            Lihat Layanan
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
