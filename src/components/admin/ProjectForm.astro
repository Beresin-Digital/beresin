---
import { Image as ImageIcon } from '@lucide/astro';
import type { Project } from '../../db/schema';
import { PROJECT_STATUSES } from '../../db/schema';
import { canonicalSrc } from '../../lib/image-variants';

/**
 * Project create/edit form.
 *
 * The status select is the honesty control. Choosing "Concept" makes the
 * client-name and label fields irrelevant — the save action clears the name and
 * forces the "Concept Project" label server-side, so the rule holds even if this
 * form is bypassed.
 */
interface Props {
  project?: Project | null;
  error?: string | null;
}

const { project = null, error = null } = Astro.props;

let submitted: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    submitted = await Astro.request.formData();
  } catch {
    /* body already consumed — fall back to the stored values */
  }
}
const field = (name: string, fallback = '') => {
  const value = submitted?.get(name);
  return typeof value === 'string' ? value : fallback;
};
const checked = (name: string, fallback: boolean) =>
  submitted ? submitted.has(name) : fallback;

const listValue = (values: string[] | undefined) => (values ?? []).join('\n');

const fieldClass =
  'mt-1 w-full rounded-lg border-2 border-black bg-white px-3 py-2 text-sm font-medium text-brand-dark outline-none focus:border-brand-dark focus:ring-2 focus:ring-brand-lime';
const labelClass =
  'font-mono block text-[10px] font-extrabold uppercase tracking-widest text-gray-500';
const helpClass = 'mt-1 block text-[10px] font-medium text-gray-400';
---

<form
  method="post"
  action="?_action=saveProject"
  enctype="multipart/form-data"
  class="space-y-6"
>
  {project && <input type="hidden" name="id" value={project.id} />}

  {
    error && (
      <p
        role="alert"
        class="rounded-lg border-2 border-black bg-brand-lime px-3 py-2 text-xs font-extrabold text-black"
      >
        {error}
      </p>
    )
  }

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="block sm:col-span-2">
      <span class={labelClass}>Judul</span>
      <input
        type="text"
        name="title"
        required
        maxlength="160"
        value={field('title', project?.title ?? '')}
        class={fieldClass}
      />
    </label>

    <label class="block">
      <span class={labelClass}>Slug</span>
      <input
        type="text"
        name="slug"
        maxlength="120"
        value={field('slug', project?.slug ?? '')}
        placeholder="otomatis dari judul"
        class={fieldClass}
      />
    </label>

    <label class="block">
      <span class={labelClass}>Kategori</span>
      <input
        type="text"
        name="category"
        maxlength="80"
        value={field('category', project?.category ?? '')}
        placeholder="Corporate Website"
        class={fieldClass}
      />
    </label>
  </div>

  <label class="block">
    <span class={labelClass}>Ringkasan singkat</span>
    <textarea name="summary" rows="3" maxlength="2000" class={fieldClass}>{field('summary', project?.summary ?? '')}</textarea>
    <span class={helpClass}>Muncul di kartu proyek.</span>
  </label>

  <label class="block">
    <span class={labelClass}>Uraian lengkap</span>
    <textarea name="overview" rows="5" maxlength="20000" class={fieldClass}>{field('overview', project?.overview ?? '')}</textarea>
    <span class={helpClass}>Muncul di jendela detail proyek.</span>
  </label>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="block">
      <span class={labelClass}>Yang dikerjakan (satu per baris)</span>
      <textarea name="scope" rows="5" maxlength="8000" class={`${fieldClass} font-mono text-xs`}>{field('scope', listValue(project?.scope))}</textarea>
    </label>

    <label class="block">
      <span class={labelClass}>Tag keahlian (satu per baris)</span>
      <textarea name="highlights" rows="5" maxlength="4000" class={`${fieldClass} font-mono text-xs`}>{field('highlights', listValue(project?.highlights))}</textarea>
    </label>
  </div>

  <fieldset class="rounded-2xl border-2 border-black bg-white p-4">
    <legend class={labelClass}>Status &amp; kejujuran</legend>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <label class="block">
        <span class={labelClass}>Status proyek</span>
        <select name="status" class={fieldClass}>
          {
            PROJECT_STATUSES.map((status) => (
              <option
                value={status}
                selected={field('status', project?.status ?? 'concept') === status}
              >
                {status === 'delivered' ? 'Delivered (dikerjakan nyata)' : 'Concept Project'}
              </option>
            ))
          }
        </select>
      </label>

      <label class="block">
        <span class={labelClass}>Label yang tampil</span>
        <input
          type="text"
          name="statusLabel"
          maxlength="40"
          value={field('statusLabel', project?.statusLabel ?? '')}
          placeholder="Delivered"
          class={fieldClass}
        />
      </label>
    </div>

    <label class="mt-4 block">
      <span class={labelClass}>Nama klien (opsional)</span>
      <input
        type="text"
        name="clientName"
        maxlength="120"
        value={field('clientName', project?.clientName ?? '')}
        placeholder="Kosongkan untuk proyek konsep"
        class={fieldClass}
      />
    </label>

    <p class="mt-3 rounded-lg bg-brand-surface px-3 py-2 text-[10px] font-medium leading-relaxed text-gray-600">
      Untuk status <strong class="font-extrabold text-brand-dark">Concept Project</strong>, nama klien
      dihapus dan label dipaksa menjadi “Concept Project” saat disimpan — jangan menyajikan pekerjaan
      yang belum dikerjakan sebagai pekerjaan klien.
    </p>
  </fieldset>

  <fieldset class="rounded-2xl border-2 border-black bg-white p-4">
    <legend class={labelClass}>Gambar proyek</legend>

    {
      project?.image && (
        <div class="mb-3 flex items-center gap-3">
          <img
            src={canonicalSrc(project.image)}
            alt=""
            width={96}
            height={64}
            class="h-16 w-24 rounded border border-gray-200 object-cover"
          />
          <label class="flex items-center gap-2 text-xs font-medium text-gray-600">
            <input
              type="checkbox"
              name="removeImage"
              value="on"
              checked={checked('removeImage', false)}
              class="h-4 w-4 accent-black"
            />
            Hapus gambar saat ini
          </label>
        </div>
      )
    }

    {
      !project?.image && (
        <p class="mb-3 flex items-center gap-2 text-xs text-gray-400">
          <ImageIcon class="h-4 w-4" stroke-width={2} aria-hidden="true" />
          Belum ada gambar.
        </p>
      )
    }

    <input
      type="file"
      name="image"
      accept="image/*"
      class="block w-full text-xs font-medium text-gray-600 file:mr-3 file:rounded-lg file:border-2 file:border-black file:bg-white file:px-3 file:py-1.5 file:text-[10px] file:font-extrabold file:uppercase file:tracking-widest file:text-brand-dark hover:file:bg-brand-lime"
    />
    <span class={helpClass}>Maks 8 MB. Dikompres otomatis ke WebP.</span>
  </fieldset>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="block">
      <span class={labelClass}>Urutan</span>
      <input
        type="number"
        name="sortOrder"
        value={field('sortOrder', String(project?.sortOrder ?? 0))}
        class={fieldClass}
      />
      <span class={helpClass}>Angka kecil tampil lebih dulu.</span>
    </label>

    <label class="mt-5 flex items-start gap-3">
      <input
        type="checkbox"
        name="isPublished"
        value="on"
        checked={checked('isPublished', project?.isPublished ?? true)}
        class="mt-0.5 h-4 w-4 accent-black"
      />
      <span>
        <span class="block text-xs font-bold text-brand-dark">Terbitkan di situs</span>
        <span class={helpClass}>Muncul di /portfolio dan bagian “Selected Work” di beranda.</span>
      </span>
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <button
      type="submit"
      class="font-mono rounded-lg border-2 border-black bg-brand-lime px-5 py-2.5 text-[11px] font-extrabold uppercase tracking-widest text-black shadow-[3px_3px_0px_#0D0F12] transition-transform hover:-translate-y-0.5"
    >
      Simpan
    </button>
    <a
      href="/admin/portfolio"
      class="font-mono rounded-lg border-2 border-black bg-white px-5 py-2.5 text-[11px] font-extrabold uppercase tracking-widest text-brand-dark transition-colors hover:bg-brand-surface"
    >
      Batal
    </a>
  </div>
</form>
