---
import { Image as ImageIcon } from '@lucide/astro';
import type { Article } from '../../db/schema';
import { ARTICLE_LOCALES, ARTICLE_STATUSES } from '../../db/schema';
import { canonicalSrc } from '../../lib/image-variants';

/**
 * Article create/edit form.
 *
 * Plain `<form method="post">` — no client JavaScript. It posts back to the same
 * page with `?_action=saveArticle`; the page reads the action result and
 * redirects to the list on success. Multipart, so the cover upload rides along
 * in the same request.
 *
 * `article` is null on the "new" page. On edit, the existing stored cover path
 * is never put in a hidden field — the action keeps the row's own value unless a
 * new file is chosen — so the form cannot be used to point at another file.
 *
 * The admin UI itself stays Indonesian; `locale` is a data field (the public
 * language the article is published in), not admin i18n. New rows default to
 * Indonesian; existing rows show their stored value.
 */
interface Props {
  article?: Article | null;
  error?: string | null;
}

const { article = null, error = null } = Astro.props;

/**
 * Values to show on a failed submit.
 *
 * The action parses the body from a *clone* of the request, so the original is
 * still readable here — which is what lets a rejected save keep the author's
 * text instead of blanking a long Markdown body. Only string fields are
 * restored; a file input cannot be repopulated, so the operator re-picks it.
 */
let submitted: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    submitted = await Astro.request.formData();
  } catch {
    /* body already consumed — fall back to the stored values */
  }
}
const field = (name: string, fallback = '') => {
  const value = submitted?.get(name);
  return typeof value === 'string' ? value : fallback;
};
const checked = (name: string) => submitted?.has(name) ?? false;

const fieldClass =
  'mt-1 w-full rounded-lg border-2 border-black bg-white px-3 py-2 text-sm font-medium text-brand-dark outline-none focus:border-brand-dark focus:ring-2 focus:ring-brand-lime';
const labelClass =
  'font-mono block text-[10px] font-extrabold uppercase tracking-widest text-gray-500';
const helpClass = 'mt-1 block text-[10px] font-medium text-gray-400';
---

<form
  method="post"
  action="?_action=saveArticle"
  enctype="multipart/form-data"
  class="space-y-6"
>
  {article && <input type="hidden" name="id" value={article.id} />}

  {
    error && (
      <p
        role="alert"
        class="rounded-lg border-2 border-black bg-brand-lime px-3 py-2 text-xs font-extrabold text-black"
      >
        {error}
      </p>
    )
  }

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="block sm:col-span-2">
      <span class={labelClass}>Judul</span>
      <input
        type="text"
        name="title"
        required
        maxlength="200"
        value={field('title', article?.title ?? '')}
        class={fieldClass}
      />
    </label>

    <label class="block">
      <span class={labelClass}>Slug</span>
      <input
        type="text"
        name="slug"
        maxlength="200"
        value={field('slug', article?.slug ?? '')}
        placeholder="otomatis dari judul"
        class={fieldClass}
      />
      <span class={helpClass}>Kosongkan untuk dibuat otomatis dari judul.</span>
    </label>

    <label class="block">
      <span class={labelClass}>Kategori</span>
      <input
        type="text"
        name="category"
        maxlength="64"
        value={field('category', article?.category ?? '')}
        placeholder="Web Development"
        class={fieldClass}
      />
    </label>
  </div>

  <label class="block">
    <span class={labelClass}>Ringkasan</span>
    <textarea name="excerpt" rows="3" maxlength="1000" class={fieldClass}>{field('excerpt', article?.excerpt ?? '')}</textarea>
    <span class={helpClass}>Muncul di daftar artikel dan sebagai deskripsi meta.</span>
  </label>

  <label class="block">
    <span class={labelClass}>Isi (Markdown)</span>
    <textarea name="body" rows="18" class={`${fieldClass} font-mono text-xs`}>{field('body', article?.body ?? '')}</textarea>
    <span class={helpClass}>
      HTML mentah tidak dijalankan — ditampilkan sebagai teks. Dukung judul (##), daftar, tautan, kutipan.
    </span>
  </label>

  <fieldset class="rounded-2xl border-2 border-black bg-white p-4">
    <legend class={labelClass}>Gambar sampul</legend>

    {
      article?.coverImage && (
        <div class="mb-3 flex items-center gap-3">
          <img
            src={canonicalSrc(article.coverImage)}
            alt=""
            width={96}
            height={64}
            class="h-16 w-24 rounded border border-gray-200 object-cover"
          />
          <label class="flex items-center gap-2 text-xs font-medium text-gray-600">
            <input
              type="checkbox"
              name="removeCover"
              value="on"
              checked={checked('removeCover')}
              class="h-4 w-4 accent-black"
            />
            Hapus gambar saat ini
          </label>
        </div>
      )
    }

    {
      !article?.coverImage && (
        <p class="mb-3 flex items-center gap-2 text-xs text-gray-400">
          <ImageIcon class="h-4 w-4" stroke-width={2} aria-hidden="true" />
          Belum ada gambar.
        </p>
      )
    }

    <input
      type="file"
      name="cover"
      accept="image/*"
      class="block w-full text-xs font-medium text-gray-600 file:mr-3 file:rounded-lg file:border-2 file:border-black file:bg-white file:px-3 file:py-1.5 file:text-[10px] file:font-extrabold file:uppercase file:tracking-widest file:text-brand-dark hover:file:bg-brand-lime"
    />
    <span class={helpClass}>Maks 8 MB. Dikompres otomatis ke WebP (320/640/960/1280 px).</span>

    <label class="mt-3 block">
      <span class={labelClass}>Teks alternatif gambar</span>
      <input
        type="text"
        name="coverAlt"
        maxlength="255"
        value={field('coverAlt', article?.coverAlt ?? '')}
        class={fieldClass}
      />
    </label>
  </fieldset>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="block">
      <span class={labelClass}>Status</span>
      <select name="status" class={fieldClass}>
        {
          ARTICLE_STATUSES.map((status) => (
            <option
              value={status}
              selected={field('status', article?.status ?? 'draft') === status}
            >
              {status === 'published' ? 'Terbit' : 'Draf'}
            </option>
          ))
        }
      </select>
    </label>

    <label class="block">
      <span class={labelClass}>Bahasa</span>
      <select name="locale" class={fieldClass}>
        {
          ARTICLE_LOCALES.map((locale) => (
            <option
              value={locale}
              selected={field('locale', article?.locale ?? 'id') === locale}
            >
              {locale === 'id' ? 'Indonesia' : 'English'}
            </option>
          ))
        }
      </select>
      <span class={helpClass}>Bahasa halaman publik tempat artikel ini tampil.</span>
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <button
      type="submit"
      class="font-mono rounded-lg border-2 border-black bg-brand-lime px-5 py-2.5 text-[11px] font-extrabold uppercase tracking-widest text-black shadow-[3px_3px_0px_#0D0F12] transition-transform hover:-translate-y-0.5"
    >
      Simpan
    </button>
    <a
      href="/admin/articles"
      class="font-mono rounded-lg border-2 border-black bg-white px-5 py-2.5 text-[11px] font-extrabold uppercase tracking-widest text-brand-dark transition-colors hover:bg-brand-surface"
    >
      Batal
    </a>
  </div>
</form>
