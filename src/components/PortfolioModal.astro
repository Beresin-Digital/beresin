---
import { Check, Image as ImageIcon } from '@lucide/astro';
import ClientBadge from './ClientBadge.astro';
import ContentImage from './ContentImage.astro';
import type { Project } from '../db/schema';

/**
 * Project detail modal.
 *
 * Same native <dialog> pattern as ConsultModal: `showModal()` gives focus
 * trapping, Esc-to-close, inert background, and ::backdrop for free. Each
 * project renders as its own panel inside the dialog, all hidden; the script
 * below unhides the one the clicked card asked for.
 *
 * Panels are pre-rendered rather than injected from JSON so the images stay
 * optimised server-side. Hidden panels are not painted, so their lazy images
 * are not fetched until the project is opened.
 *
 * `projects` is passed in by the page (DB-backed on both `/` and `/portfolio`),
 * so this component stays a pure renderer.
 */
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const hasImage = (p: Project) => Boolean(p.image && p.imageWidth && p.imageHeight);
---

<dialog
  id="portfolio-modal"
  class="portfolio-dialog relative m-auto max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-3xl border-2 border-black bg-white p-0 text-brand-dark shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm"
  aria-label="Project details"
>
  <button
    type="button"
    data-close-modal
    class="absolute right-3 top-3 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-black bg-white text-brand-dark shadow-[2px_2px_0px_#0D0F12] transition-colors hover:bg-brand-lime"
    aria-label="Close project details"
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  {
    projects.map((project) => (
      <article data-project-panel={project.id} hidden>
        <div class="relative aspect-[16/9] overflow-hidden border-b-2 border-black">
          {hasImage(project) ? (
            <ContentImage
              src={project.image!}
              alt={project.title}
              width={project.imageWidth!}
              height={project.imageHeight!}
              sizes="(min-width: 768px) 48rem, 100vw"
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-brand-surface text-gray-400">
              <ImageIcon class="h-10 w-10" stroke-width={1.5} aria-hidden="true" />
            </div>
          )}
          <span
            class:list={[
              'font-mono absolute left-4 top-4 rounded border border-black px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-black shadow-[2px_2px_0px_#0D0F12]',
              project.status === 'delivered' ? 'bg-brand-lime' : 'bg-white',
            ]}
          >
            {project.statusLabel}
          </span>
        </div>

        <div class="p-6 sm:p-8">
          {
            project.clientName && (
              <div class="mb-5 border-b border-gray-100 pb-5">
                <ClientBadge name={project.clientName} logo={project.clientLogo} />
              </div>
            )
          }
          <p class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
            {project.category}
          </p>
          <h2
            id={`project-title-${project.id}`}
            class="font-display mt-2 text-2xl font-black uppercase leading-tight tracking-tight text-brand-dark sm:text-3xl"
          >
            {project.title}
          </h2>

          <p class="mt-4 text-sm font-medium leading-relaxed text-gray-700">
            {project.overview}
          </p>

          <h3 class="font-mono mt-7 text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
            What we did
          </h3>
          <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2">
            {project.scope.map((item) => (
              <li class="flex items-start gap-2.5">
                <span
                  class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-black bg-brand-lime text-black"
                  aria-hidden="true"
                >
                  <Check class="h-2.5 w-2.5" stroke-width={4} />
                </span>
                <span class="text-xs font-semibold leading-snug text-brand-dark">{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-7 flex flex-wrap gap-2">
            {project.highlights.map((tag) => (
              <span class="rounded-full border border-black bg-brand-surface px-3 py-1 text-[11px] font-extrabold uppercase tracking-wide text-brand-dark">
                {tag}
              </span>
            ))}
          </div>

          <a
            href="/contact"
            class="font-mono mt-7 inline-flex items-center gap-2 rounded-full border border-black bg-brand-lime px-5 py-3 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
          >
            Start a project like this
          </a>
        </div>
      </article>
    ))
  }
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('portfolio-modal');
    if (!dlg || typeof dlg.showModal !== 'function') return;

    var panels = dlg.querySelectorAll('[data-project-panel]');

    function open(id) {
      var found = false;
      panels.forEach(function (panel) {
        var match = panel.getAttribute('data-project-panel') === id;
        if (match) {
          panel.removeAttribute('hidden');
          found = true;
        } else {
          panel.setAttribute('hidden', '');
        }
      });
      if (!found) return;
      dlg.setAttribute('aria-labelledby', 'project-title-' + id);
      dlg.scrollTop = 0;
      dlg.showModal();
    }

    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-project-id]');
      if (trigger) {
        var id = trigger.getAttribute('data-project-id');
        if (id) open(id);
        return;
      }

      if (event.target.closest('[data-close-modal]') && dlg.contains(event.target)) {
        dlg.close();
        return;
      }

      // Click on the dialog element itself (i.e. the backdrop) closes it.
      if (event.target === dlg) dlg.close();
    });
  })();
</script>
