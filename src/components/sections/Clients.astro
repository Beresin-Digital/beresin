---
import ClientChip from '../ClientChip.astro';
import type { Client } from '../../db/schema';
import { dicts, type Locale } from '../../i18n';

/**
 * Trusted-partners section.
 *
 * `clients` is passed in by the page (active rows from the DB, in the owner's
 * order). The display gate is `isActive` alone — `isRealEngagement` is advisory
 * and deliberately not consulted here (see the clients schema for why). The
 * section renders nothing when the list is empty.
 *
 * Two layouts, chosen by list length. A marquee only reads as intentional when
 * one pass of the row is at least as wide as the viewport: below that the track
 * is narrower than the screen, so the -50% loop reveals empty space and the same
 * two or three chips slide past on repeat. With a short list the chips are
 * simply centred instead, which stays clean at any count.
 *
 * Client names, categories, and logos come from the DB as entered by the
 * admin and are shown unfiltered on both locales.
 */
interface Props {
  clients: Client[];
  locale?: Locale;
}

const { clients, locale = 'en' } = Astro.props;
const d = dicts[locale];

/** Below this, one pass of the row does not fill a desktop viewport. */
const MARQUEE_MIN = 8;
const useMarquee = clients.length >= MARQUEE_MIN;
---

{
  clients.length > 0 && (
    <section
      id="clients"
      class="overflow-hidden border-b border-gray-200 bg-white py-16 text-brand-dark"
    >
      <div class="mx-auto mb-10 max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs font-extrabold uppercase tracking-widest">
          <span class="rounded border border-black bg-brand-lime px-3 py-1 text-black shadow-[2px_2px_0px_#0D0F12]">
            {d.clientsSection.eyebrow}
          </span>
        </p>
        <h2 class="font-display text-3xl font-black uppercase tracking-tight text-brand-dark sm:text-4xl">
          {d.clientsSection.heading}
        </h2>
        <p class="mx-auto mt-2 max-w-2xl text-xs font-medium text-gray-600 sm:text-sm">
          {d.clientsSection.lead}
        </p>
      </div>

      {useMarquee ? (
        <div class="relative w-full overflow-hidden py-3">
          <div class="animate-marquee will-change-transform flex w-max">
            {[0, 1].map(() => (
              <div class="flex shrink-0 items-center gap-7 pr-7">
                {clients.map((client, i) => (
                  <ClientChip client={client} index={i} />
                ))}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <ul class="flex flex-wrap items-center justify-center gap-1 sm:gap-5">
            {clients.map((client, i) => (
              <li>
                <ClientChip client={client} index={i} />
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}
