---
import { Picture } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { services } from '../../data/services';
import { dicts, localizePath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const d = dicts[locale];
---

<section id="services" class="border-b border-black bg-brand-dark py-20 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p
          class="font-mono mb-3 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-brand-lime"
        >
          <svg class="h-4 w-4 fill-brand-lime" viewBox="0 0 24 24" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          {d.servicesSection.eyebrow}
        </p>
        <h2
          class="font-display max-w-2xl text-3xl font-black uppercase leading-none tracking-tight text-white sm:text-5xl"
        >
          {d.servicesSection.heading}
        </h2>
      </div>

      <div>
        <a
          href={localizePath('/services', locale)}
          class="font-mono inline-block rounded-full border border-white/20 bg-white/10 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-white transition-all hover:bg-white/20"
        >
          {d.servicesSection.allServices}
        </a>
      </div>
    </div>

    <!-- Four equal services in a four-up grid (two-up from sm). At lg (1024) a
         four-column grid squeezes the cards to ~222px, which forces 3-line
         titles and 5-line descriptions; two-up there reads far better, so the
         four-up layout only kicks in at xl. -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        services[locale].map((service) => (
          <article class="group flex flex-col justify-between space-y-6 rounded-3xl border border-white/10 bg-white/5 p-6 transition-all hover:border-brand-lime">
            <div>
              <div class="mb-4 flex items-center justify-between">
                <h3 class="font-display text-xl font-black uppercase text-white transition-colors group-hover:text-brand-lime">
                  {service.title}
                </h3>
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-lime font-bold text-black"
                  aria-hidden="true"
                >
                  <ArrowUpRight class="h-5 w-5" stroke-width={2.5} />
                </span>
              </div>
              <p class="text-xs font-medium leading-relaxed text-gray-400">{service.description}</p>
            </div>

            <div class="aspect-[3/2] overflow-hidden rounded-2xl border border-white/10">
              <Picture
                src={service.image.src}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 23vw, (min-width: 640px) 46vw, 90vw"
                alt={service.image.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
