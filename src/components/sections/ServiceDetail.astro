---
import { Picture } from 'astro:assets';
import { ArrowUpRight, Check } from '@lucide/astro';
import type { Service } from '../../data/services';
import { dicts, type Locale } from '../../i18n';

/**
 * One service, expanded. Used only by /services — the homepage keeps the compact
 * four-card grid in `Services.astro`.
 *
 * The alternating side (text left / image left) is driven by `index`, so adding
 * or removing a service in `services.ts` alternates automatically. The tinted
 * background rides on the same parity, which is what stops the stack from
 * reading as a wall of identical rows.
 */
interface Props {
  service: Service;
  index: number;
  locale?: Locale;
}

const { service, index, locale = 'en' } = Astro.props;
const d = dicts[locale];

/** Two-digit ordinal — 01, 02, 03. */
const ordinal = String(index + 1).padStart(2, '0');

/** Odd pillars flip the image to the left and tint the section. */
const flipped = index % 2 === 1;
---

<section
  id={service.id}
  class:list={[
    'border-b border-gray-200 py-16 text-brand-dark sm:py-20',
    flipped ? 'bg-brand-surface' : 'bg-white',
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Text column -->
      <div class:list={['min-w-0 lg:col-span-7', flipped && 'lg:order-2']}>
        <div class="flex items-center gap-4">
          <span
            class="font-display inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border-2 border-black bg-brand-lime text-lg font-black tabular-nums text-black shadow-[3px_3px_0px_#0D0F12]"
            aria-hidden="true"
          >
            {ordinal}
          </span>
          <span class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
            {d.serviceDetail.serviceLabel}
          </span>
        </div>

        <h2
          class="font-display mt-5 text-3xl font-black uppercase leading-none tracking-tight text-brand-dark sm:text-4xl"
        >
          {service.title}
        </h2>

        <p class="mt-4 max-w-2xl text-sm font-medium leading-relaxed text-gray-700 sm:text-base">
          {service.longDescription}
        </p>

        <!-- Deliverables -->
        <h3 class="font-mono mt-8 text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
          {d.serviceDetail.whatYouGet}
        </h3>
        <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2">
          {
            service.deliverables.map((item) => (
              <li class="flex items-start gap-2.5">
                <span
                  class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-black bg-brand-lime text-black"
                  aria-hidden="true"
                >
                  <Check class="h-2.5 w-2.5" stroke-width={4} />
                </span>
                <span class="text-xs font-semibold leading-snug text-brand-dark">{item}</span>
              </li>
            ))
          }
        </ul>

        <!-- Audience + CTA -->
        <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
              {d.serviceDetail.bestFor}
            </h3>
            <ul class="mt-2.5 flex flex-wrap gap-2">
              {
                service.audience.map((who) => (
                  <li class="rounded-full border border-black bg-white px-3 py-1 text-[11px] font-extrabold uppercase tracking-wide text-brand-dark">
                    {who}
                  </li>
                ))
              }
            </ul>
          </div>

          <button
            type="button"
            data-open-modal={`${d.serviceDetail.discussVerb} ${service.title}`}
            class="font-mono inline-flex shrink-0 items-center gap-2 rounded-full border border-black bg-brand-lime px-5 py-3 text-xs font-black uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
          >
            {d.serviceDetail.discussService}
            <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
          </button>
        </div>
      </div>

      <!-- Image column -->
      <div class:list={['lg:col-span-5', flipped && 'lg:order-1']}>
        <div class="overflow-hidden rounded-3xl border-2 border-black bg-white shadow-[8px_8px_0px_#0D0F12]">
          <Picture
            src={service.image.src}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            alt={service.image.alt}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
