---
import { ArrowUpRight } from '@lucide/astro';
import ProjectCard from '../ProjectCard.astro';
import type { Project } from '../../db/schema';

/**
 * "Selected Work": the homepage portfolio teaser.
 *
 * The full set lives on /portfolio; this section shows the same cards and links
 * there. Anything marked as a concept carries a visible label (enforced in
 * `src/lib/projects.ts` before the row is written).
 *
 * `projects` is passed in by the page (published rows from the DB). The section
 * renders nothing when the list is empty, so an empty table degrades cleanly.
 */
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <section id="portfolio" class="bg-brand-surface py-24 text-brand-dark">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
        <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="mb-4">
              <span class="font-display rounded-full border-2 border-black bg-brand-dark px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-brand-lime">
                Selected Work
              </span>
            </p>
            <h2
              class="font-display max-w-2xl text-3xl font-bold uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
            >
              Work we can show.
            </h2>
          </div>
          <div class="max-w-sm space-y-4">
            <p class="text-xs font-medium leading-relaxed text-brand-muted sm:text-sm">
              A sample of the solutions we build. Concept work is labelled as such: we only present
              delivered projects as delivered.
            </p>
            <a
              href="/portfolio"
              class="font-display inline-flex items-center gap-2 rounded-2xl border-2 border-black bg-white px-6 py-3 text-xs font-bold uppercase tracking-wider text-black shadow-hard transition-all hover:translate-x-1 hover:translate-y-1 hover:bg-brand-smoke hover:shadow-none"
            >
              View all work
              <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )
}
