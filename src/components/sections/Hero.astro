---
import { Picture } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { images } from '../../assets/images/manifest';
---

<section id="hero" class="relative overflow-hidden bg-brand-surface py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8">
      <!-- Headline, subtext, featured photo -->
      <div class="space-y-6">
        <div class="relative">
          <div class="absolute -top-4 right-4 text-black sm:right-20">
            <svg
              class="h-8 w-8 stroke-black stroke-[1.5] sm:h-12 sm:w-12"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                class="fill-brand-lime"></polygon>
            </svg>
          </div>

          <h1
            class="font-display text-4xl font-bold uppercase leading-none tracking-tight text-brand-dark sm:text-6xl lg:text-7xl"
          >
            <span
              class="mb-1 inline-block rounded-lg border-2 border-black bg-brand-lime px-2 py-0.5 text-black shadow-hard-sm"
            >
              DIGITAL SOLUTIONS
            </span><br />
            BUILT FOR YOUR BUSINESS<span class="text-brand-lime" aria-hidden="true">.</span>
          </h1>
        </div>

        <div class="grid grid-cols-1 items-center gap-6 pt-2 md:grid-cols-12">
          <div class="space-y-4 md:col-span-6">
            <p class="text-sm font-medium leading-relaxed text-brand-muted sm:text-base">
              We design and develop <span
                class="font-bold text-brand-dark underline decoration-brand-lime decoration-4"
                >websites, applications, and custom digital solutions</span
              > that help businesses work smarter and grow.
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2">
              <button
                type="button"
                data-open-modal="Discuss Your Project"
                class="font-display inline-flex items-center gap-2 rounded-2xl border-2 border-black bg-brand-lime px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-black shadow-hard transition-all hover:translate-x-1 hover:translate-y-1 hover:bg-brand-dark hover:text-brand-lime hover:shadow-none"
              >
                Discuss Your Project <ArrowRight class="h-4 w-4" stroke-width={2.5} />
              </button>
              <a
                href="#portfolio"
                class="font-display inline-flex items-center gap-2 rounded-2xl border-2 border-black bg-white px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-black shadow-hard transition-all hover:translate-x-1 hover:translate-y-1 hover:bg-brand-smoke hover:shadow-none"
              >
                Explore Our Work <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
              </a>
            </div>
          </div>

          <div class="relative md:col-span-6">
            <div
              class="relative h-64 overflow-hidden rounded-3xl border-2 border-black bg-brand-dark shadow-hard-lg sm:h-72"
            >
              <Picture
                src={images.heroTeam.src}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[400, 600, 800, 1200]}
                sizes="(min-width: 768px) 45vw, 100vw"
                alt={images.heroTeam.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover opacity-90 transition-transform duration-500 hover:scale-105"
              />

              <div
                class="absolute bottom-4 left-4 flex items-center gap-2 rounded-2xl border-2 border-black bg-white px-4 py-2 font-display text-xs font-bold uppercase tracking-wide shadow-hard-sm"
              >
                <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-green-500"></span>
                <span>WEBSITES · APPS · CUSTOM SYSTEMS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
