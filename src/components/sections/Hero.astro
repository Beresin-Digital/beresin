---
import { Picture } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { images } from '../../assets/images/manifest';
import { dicts, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const d = dicts[locale];

// headlineRest carries its trailing period; slice it off so the period renders
// in lime, like the original markup (BUILT FOR YOUR BUSINESS + lime dot).
const headline = d.hero.headlineRest.slice(0, -1);
---

<section id="hero" class="bg-grid-light relative overflow-hidden border-b border-gray-200 bg-white py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8">
      <!-- Headline, subtext, featured photo -->
      <div class="space-y-6">
        <div class="relative">
          <div class="absolute -top-4 right-4 text-black sm:right-20">
            <svg
              class="h-8 w-8 stroke-black stroke-[1.5] sm:h-12 sm:w-12"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                class="fill-brand-lime"></polygon>
            </svg>
          </div>

          <h1
            class="font-display text-4xl font-black uppercase leading-none tracking-tighter text-brand-dark sm:text-6xl lg:text-7xl"
          >
            <span
              class="mb-1 inline-block border-2 border-black bg-brand-lime px-2 py-0.5 text-black shadow-[4px_4px_0px_#0D0F12]"
            >
              {d.hero.badge}
            </span><br />
            {headline}<span class="text-brand-lime">.</span>
          </h1>
        </div>

        <div class="grid grid-cols-1 items-center gap-6 pt-2 md:grid-cols-12">
          <div class="space-y-4 md:col-span-6">
            <p class="text-sm font-semibold leading-relaxed text-gray-700">
              {d.hero.leadStart}<span
                class="font-black text-black underline decoration-brand-lime decoration-4"
                >{d.hero.leadEmphasis}</span
              >{d.hero.leadEnd}
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2">
              <button
                type="button"
                data-open-modal={d.modalSubjects.discussProject}
                class="font-mono flex items-center gap-2 rounded-full border border-black bg-brand-dark px-6 py-3.5 text-xs font-extrabold uppercase tracking-wider text-white shadow-[3px_3px_0px_#D2EB1E] transition-all hover:bg-black"
              >
                {d.hero.ctaDiscuss} <ArrowRight class="h-4 w-4 text-brand-lime" stroke-width={2.5} />
              </button>
              <a
                href="#portfolio"
                class="font-mono flex items-center gap-2 rounded-full border border-black bg-brand-lime px-6 py-3.5 text-xs font-extrabold uppercase tracking-wider text-black shadow-[3px_3px_0px_#0D0F12] transition-all hover:bg-brand-lime-hover"
              >
                {d.hero.ctaExplore} <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
              </a>
            </div>
          </div>

          <div class="relative md:col-span-6">
            <div
              class="relative h-64 overflow-hidden rounded-3xl border-2 border-black bg-brand-dark shadow-[8px_8px_0px_#0D0F12] sm:h-72"
            >
              <Picture
                src={images.heroTeam.src}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[400, 600, 800, 1200]}
                sizes="(min-width: 768px) 45vw, 100vw"
                alt={d.images.heroTeam}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover opacity-90 transition-transform duration-500 hover:scale-105"
              />

              <div
                class="absolute bottom-4 left-4 flex items-center gap-2 rounded-2xl border border-black bg-white/90 px-4 py-2 text-xs font-black shadow-md backdrop-blur-md"
              >
                <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-green-500"></span>
                <span>{d.hero.strip}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
