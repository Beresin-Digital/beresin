---
import { achievements, milestones } from '../../data/milestones';

/**
 * "Tonggak & pencapaian" for /tentang.
 *
 * Two parts:
 *  1. `achievements` — the owner-confirmed figures, always rendered.
 *  2. `milestones` — the dated history, rendered ONLY when the array has entries.
 *     It is empty today because no founding year or dated milestone has been
 *     supplied, and inventing one would be a fabricated claim. An empty `<ol>`
 *     is not emitted at all, so nothing on the page promises a timeline it
 *     cannot show.
 *
 * The stats use a `<dl>` rather than a row of headings: they are data, not
 * document structure, so they should not appear in the heading outline.
 */
const hasTimeline = milestones.length > 0;
---

<section id="pencapaian" class="border-b border-gray-200 bg-white py-16 text-brand-dark sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-2xl">
      <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs font-extrabold uppercase tracking-widest">
        <span class="rounded border border-black bg-brand-lime px-3 py-1 text-black shadow-[2px_2px_0px_#0D0F12]">
          Tonggak &amp; Pencapaian
        </span>
      </p>
      <h2
        class="font-display text-3xl font-black uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
      >
        Sejauh mana kami sudah jalan.
      </h2>
      <p class="mt-4 text-sm font-medium leading-relaxed text-gray-700 sm:text-base">
        Angka yang kami cantumkan di sini yang bisa kami pertanggungjawabkan — bukan estimasi
        pemasaran.
      </p>
    </div>

    <dl class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      {
        achievements.map((item) => (
          <div class="border-t-2 border-black pt-4">
            <dt class="font-mono text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
              {item.label}
            </dt>
            <dd class="font-display mt-2 text-4xl font-black tabular-nums leading-none text-brand-dark sm:text-5xl">
              {item.value}
              <span class="ml-1 rounded bg-black px-1.5 text-brand-lime">{item.suffix}</span>
            </dd>
            <dd class="mt-3 text-[11px] font-medium leading-relaxed text-gray-600 sm:text-xs">
              {item.note}
            </dd>
          </div>
        ))
      }
    </dl>

    {
      hasTimeline && (
        <div class="mt-16">
          <h3 class="font-mono border-b-2 border-black pb-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-600">
            Perjalanan
          </h3>
          <ol>
            {milestones.map((m) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-5 border-b border-gray-200 py-6 sm:gap-x-8">
                <time class="font-display text-lg font-black tabular-nums leading-none text-gray-500 sm:text-xl">
                  {m.when}
                </time>
                <div>
                  <h4 class="font-display text-base font-black uppercase leading-snug tracking-tight text-brand-dark">
                    {m.title}
                  </h4>
                  <p class="mt-2 text-xs font-medium leading-relaxed text-gray-700 sm:text-sm">
                    {m.description}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>
