---
import { reasons } from '../../data/why-choose';

/**
 * "Why choose us": four differentiators.
 *
 * Each reason is backed by something already promised elsewhere on the site
 * (see `data/why-choose.ts`). Rendered as four compartment cards with numbered
 * lime chips.
 */
---

<section id="why-us" class="bg-white py-24 text-brand-dark">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="mb-12 max-w-2xl">
      <p class="mb-4">
        <span class="font-display rounded-full border-2 border-black bg-brand-dark px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-brand-lime">
          Why Choose Us
        </span>
      </p>
      <h2
        class="font-display text-3xl font-bold uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
      >
        Why work with us.
      </h2>
      <p class="mt-4 text-sm font-medium leading-relaxed text-brand-muted sm:text-base">
        Four things that hold whether you are commissioning a website or a system the business runs
        on.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        reasons.map((reason, i) => (
          <article
            class:list={[
              'flex flex-col rounded-3xl border-2 border-black p-6 shadow-hard',
              i % 2 === 0 ? 'bg-white' : 'bg-brand-smoke',
            ]}
          >
            <span
              class="font-display inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border-2 border-black bg-brand-lime text-base font-bold tabular-nums text-black shadow-hard-sm"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display mt-5 text-lg font-bold uppercase leading-snug tracking-tight text-brand-dark">
              {reason.title}
            </h3>
            <p class="mt-3 text-xs font-medium leading-relaxed text-brand-muted sm:text-sm">
              {reason.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
