---
import { reasons } from '../../data/why-choose';

/**
 * "Why choose us" — four differentiators.
 *
 * Each reason is backed by something already promised elsewhere on the site
 * (see `data/why-choose.ts`). Rendered as an equal four-up grid of cards with
 * numbered lime badges, echoing the Process section's numerals.
 */
---

<section id="why-us" class="border-b border-gray-200 bg-brand-surface py-20 text-brand-dark">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs font-extrabold uppercase tracking-widest">
        <span class="rounded border border-black bg-brand-lime px-3 py-1 text-black shadow-[2px_2px_0px_#0D0F12]">
          Why Choose Us
        </span>
      </p>
      <h2
        class="font-display text-3xl font-black uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
      >
        Why work with us.
      </h2>
      <p class="mt-4 text-sm font-medium leading-relaxed text-gray-700 sm:text-base">
        Four things that hold whether you are commissioning a website or a system the business runs
        on.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        reasons.map((reason, i) => (
          <article class="flex flex-col rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
            <span
              class="font-display inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-black bg-brand-lime text-base font-black tabular-nums text-black shadow-[3px_3px_0px_#0D0F12]"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display mt-5 text-lg font-black uppercase leading-snug tracking-tight text-brand-dark">
              {reason.title}
            </h3>
            <p class="mt-3 text-xs font-medium leading-relaxed text-gray-600 sm:text-sm">
              {reason.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
