---
import { Picture } from 'astro:assets';
import { Check, ShieldCheck } from '@lucide/astro';
import { images } from '../../assets/images/manifest';
import { coverage } from '../../data/services';

/**
 * Two short credibility badges. Both are factual statements, not metrics: how
 * we run a project, and the kind of client base we work with (not "global
 * brands", not an unverifiable number).
 */
const badges = [
  { icon: Check, label: 'Structured delivery & clear scope', tone: 'lime' },
  { icon: ShieldCheck, label: 'Trusted by businesses, schools & agencies', tone: 'dark' },
] as const;
---

<section id="about" class="bg-white py-24 text-brand-dark">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <!-- Left: intro + badges -->
      <div class="space-y-6 lg:col-span-8">
        <p>
          <span class="font-display rounded-full border-2 border-black bg-brand-dark px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-brand-lime">
            Who we are
          </span>
        </p>
        <h2
          class="font-display text-3xl font-bold uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
        >
          Design and engineering, under one roof.
        </h2>
        <p class="max-w-xl text-sm font-medium leading-relaxed text-brand-muted sm:text-base">
          Beresin Digital helps businesses build and grow their digital products, from professional
          websites to applications and custom systems. We pair clear design with dependable
          engineering, and deliver on a structured timeline.
        </p>

        <ul class="space-y-4 pt-2">
          {
            badges.map((badge) => (
              <li class="flex items-center gap-3">
                <span
                  class:list={[
                    'flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-black font-bold',
                    badge.tone === 'lime' ? 'bg-brand-lime text-black' : 'bg-brand-dark text-brand-lime',
                  ]}
                  aria-hidden="true"
                >
                  <badge.icon class="h-4 w-4" stroke-width={2.25} />
                </span>
                <span class="font-display text-xs font-bold uppercase tracking-wide text-brand-dark">{badge.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right: what the studio covers -->
      <div class="space-y-6 rounded-3xl border-2 border-black bg-brand-surface p-6 shadow-hard sm:p-8 lg:col-span-4">
        <h3 class="font-display border-b-2 border-black pb-3 text-sm font-bold uppercase tracking-wide text-brand-dark">
          What we cover
        </h3>

        <ul class="space-y-4">
          {
            coverage.map((item) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-black bg-brand-lime text-black"
                  aria-hidden="true"
                >
                  <Check class="h-3.5 w-3.5" stroke-width={3} />
                </span>
                <span>
                  <span class="block text-xs font-bold text-brand-dark">{item.label}</span>
                  <span class="mt-0.5 block text-[11px] leading-relaxed text-brand-muted">
                    {item.note}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="pt-2">
          <a
            href="/services"
            class="font-display block w-full rounded-2xl border-2 border-black bg-white py-3 text-center text-xs font-bold uppercase tracking-wider text-black shadow-hard-sm transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-brand-smoke hover:shadow-none"
          >
            See service details
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
