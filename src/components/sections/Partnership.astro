---
import { ArrowUpRight, Building2, Code, Megaphone, Palette } from '@lucide/astro';
import { partnerTypes } from '../../data/partners';

/**
 * "Partnership": who we collaborate with.
 *
 * Light bento compartments on cream. The icon set mirrors the clients marquee.
 */
const icons = {
  'building-2': Building2,
  palette: Palette,
  megaphone: Megaphone,
  code: Code,
} as const;

function iconFor(name: string) {
  return icons[name as keyof typeof icons] ?? Building2;
}
---

<section id="partnership" class="bg-brand-surface py-24 text-brand-dark">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="mb-4">
          <span class="font-display rounded-full border-2 border-black bg-brand-dark px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-brand-lime">
            Partnership
          </span>
        </p>
        <h2
          class="font-display text-3xl font-bold uppercase leading-none tracking-tight text-brand-dark sm:text-5xl"
        >
          Let&rsquo;s build together.
        </h2>
        <p class="mt-4 max-w-xl text-sm font-medium leading-relaxed text-brand-muted sm:text-base">
          Beyond direct clients, we work as a development partner for teams and agencies who need
          the build handled, under your brand or ours.
        </p>

        <button
          type="button"
          data-open-modal="Discuss a Partnership"
          class="font-display mt-7 inline-flex items-center gap-2 rounded-2xl border-2 border-black bg-brand-lime px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-black shadow-hard transition-all hover:translate-x-1 hover:translate-y-1 hover:bg-brand-dark hover:text-brand-lime hover:shadow-none"
        >
          Discuss a Partnership
          <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
        </button>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-7">
        {
          partnerTypes.map((partner, i) => {
            const Icon = iconFor(partner.icon);
            return (
              <article
                class:list={[
                  'flex flex-col rounded-3xl border-2 border-black p-6 shadow-hard transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none',
                  i % 2 === 0 ? 'bg-white' : 'bg-brand-smoke',
                ]}
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-black bg-brand-lime text-black"
                  aria-hidden="true"
                >
                  <Icon class="h-5 w-5" stroke-width={2.25} />
                </span>
                <h3 class="font-display mt-4 text-base font-bold uppercase leading-snug tracking-tight text-brand-dark">
                  {partner.title}
                </h3>
                <p class="mt-2 text-xs font-medium leading-relaxed text-brand-muted sm:text-sm">
                  {partner.description}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
