---
import { site, whatsappLink } from '../data/site';

const year = new Date().getFullYear();

const menuLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Clients', href: '/#clients' },
  { label: 'Articles', href: '/articles' },
  { label: 'Direktori Sekolah', href: '/sekolah' },
  { label: 'About', href: '/about' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms & Conditions', href: '/terms-and-conditions' },
];
---

<footer class="border-t-2 border-black bg-brand-dark pt-16 pb-12 text-white">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 border-b border-white/10 pb-12 md:grid-cols-12">
      <div class="space-y-4 md:col-span-6">
        <span class="font-display text-3xl font-bold tracking-tight text-white">
          beresin<span class="text-brand-lime">digital</span><span
          class="ml-0.5 inline-block h-2.5 w-2.5 rounded-full bg-white"></span>
        </span>
        <p class="max-w-sm text-xs font-medium leading-relaxed text-gray-400">
          Digital solutions &amp; development partner for websites, mobile apps, custom web
          applications, IoT solutions, system integration, and graphic design.
        </p>
      </div>

      <nav class="space-y-3 md:col-span-3" aria-labelledby="footer-menu-heading">
        <h2
          id="footer-menu-heading"
          class="font-display text-xs font-bold uppercase tracking-wider text-brand-lime"
        >
          Navigation
        </h2>
        <ul class="space-y-2 text-xs font-medium text-gray-400">
          {
            menuLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="space-y-3 md:col-span-3">
        <h2
          class="font-display text-xs font-bold uppercase tracking-wider text-brand-lime"
        >
          Contact
        </h2>
        <address class="font-display space-y-1 text-xs not-italic text-gray-400 [overflow-wrap:anywhere]">
          <p>{site.legalName}</p>
          <p>{site.address.city}, {site.address.countryName}</p>
          <p class="pt-2">
            Email: <a href={`mailto:${site.emailProcurement}`} class="hover:text-white">
              {site.emailProcurement}
            </a>
          </p>
          <p>
            WA: <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white">{site.whatsappDisplay}</a>
          </p>
        </address>
      </div>
    </div>

    <div
      class="font-display flex flex-col items-center justify-between gap-4 pt-8 text-[11px] text-gray-400 sm:flex-row"
    >
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul class="flex items-center gap-4">
        <li><button type="button" data-cookie-preferences hidden class="min-h-11 underline hover:text-gray-300">Cookie Preferences</button></li>
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-gray-300">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
