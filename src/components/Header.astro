---
import { ArrowUpRight, Menu, MessageCircle, X } from '@lucide/astro';
import { whatsappLink } from '../data/site';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'About', href: '/about' },
  { label: 'Articles', href: '/articles' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href === currentPath;
---

<header class="sticky top-0 z-50 border-b-2 border-black bg-white">
  <div class="mx-auto flex h-20 max-w-[1200px] items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand. No aria-label: WCAG 2.5.3 requires the accessible name to contain
         the visible text, so the "- home" hint is a real (screen-reader-only)
         text node rather than an overriding label. The mark is the real logo PNG
         (generated from the source file by scripts/make-icons.mjs), a hand-drawn
         SVG drifted from the actual mark, so we ship the bitmap instead. -->
    <a href="/" class="group flex items-center gap-3">
      <span class="relative h-9 w-9 shrink-0 sm:h-10 sm:w-10">
        <img
          src="/logo-mark.png"
          alt=""
          width="96"
          height="96"
          loading="eager"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </span>
      <span class="font-display text-2xl font-bold tracking-tight text-brand-dark">
        beresin<span>digital</span><span
          class="ml-0.5 inline-block h-2.5 w-2.5 rounded-full bg-brand-lime"></span>
      </span>
      <span class="sr-only">- home</span>
    </a>

    <!-- Desktop nav. Shown from `lg`, not `md`: six items plus the wordmark and
         the CTA do not fit on one line at 768px, and the overflow makes the
         whole page scroll sideways on a tablet. Below `lg` the hamburger menu
         carries the same links. -->
    <nav
      class="font-display hidden items-center gap-4 text-xs font-bold uppercase tracking-wider text-brand-muted lg:flex"
      aria-label="Main navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="transition-colors hover:text-black"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA. Points at /contact rather than straight into WhatsApp: the
         contact page is where the form, the email, and the WhatsApp link all
         live, so a visitor who is not ready to chat in an app still has a path.
         The mobile menu below keeps its direct WhatsApp button: on a phone
         that one tap is the fastest route, and the menu already lists Contact. -->
    <div class="hidden items-center gap-3 sm:flex">
      <a
        href="/contact"
        class="font-display flex items-center gap-2 rounded-2xl border-2 border-black bg-brand-lime px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-black shadow-hard-sm transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-brand-dark hover:text-brand-lime hover:shadow-none"
      >
        Get in Touch
        <ArrowUpRight class="h-4 w-4" stroke-width={2.5} />
      </a>
    </div>

    <!-- Mobile menu: CSS-only via <details>, no JS required to open/close.
         The panel is `absolute` against the header (a positioned ancestor via
         `sticky`), NOT against this <details>; a `relative` here would make the
         containing block the hamburger button itself, squashing the panel to
         ~40px wide and wrapping every label to one character per line. -->
    <details class="group mobile-menu lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-2xl border-2 border-black bg-white text-brand-dark shadow-hard-sm transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-brand-smoke hover:shadow-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
        aria-label="Navigation menu"
      >
        <Menu class="h-6 w-6 group-open:hidden" stroke-width={2.5} aria-hidden="true" />
        <X class="hidden h-6 w-6 group-open:block" stroke-width={2.5} aria-hidden="true" />
      </summary>

      <!-- Panel spans the full viewport width and drops from the header's
           bottom edge. `max-h` + scroll keeps it usable in landscape on short
           phones; the inner `max-w-[1200px]` box keeps the links aligned with the
           rest of the page instead of hugging the screen edges. -->
      <div
        class="absolute inset-x-0 top-full max-h-[calc(100dvh-5rem)] overflow-y-auto border-b-2 border-black bg-white shadow-hard"
      >
        <nav
          class="mx-auto max-w-[1200px] px-4 py-2 sm:px-6 lg:px-8"
          aria-label="Mobile navigation"
        >
          <ul class="divide-y divide-brand-border">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="font-display flex items-center justify-between py-4 text-sm font-bold uppercase tracking-wide text-brand-muted transition-colors hover:text-black"
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                    {isCurrent(item.href) && (
                      <span class="h-2 w-2 rounded-full bg-brand-lime ring-1 ring-black" aria-hidden="true" />
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mx-auto max-w-[1200px] border-t border-brand-border px-4 py-5 sm:px-6 lg:px-8">
          <a
            href={whatsappLink('Hi Beresin Digital, I would like to discuss a digital project.')}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display flex w-full items-center justify-center gap-2 rounded-2xl border-2 border-black bg-brand-lime py-3.5 text-xs font-bold uppercase tracking-wider text-black shadow-hard-sm transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-brand-dark hover:text-brand-lime hover:shadow-none"
          >
            <MessageCircle class="h-4 w-4" stroke-width={2.5} aria-hidden="true" />
            Chat on WhatsApp
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<!--
  <details> gives us open/close for free. Close it when focus leaves the menu,
  when the page behind it is tapped, and when Escape is pressed. The
  menu is still fully usable without this script: it is an enhancement, not a
  dependency. Kept inline (like ConsultModal) so there is no bundle to fetch.
-->
<script is:inline>
  (function () {
    var menu = document.querySelector('.mobile-menu');
    if (!menu) return;
    var summary = menu.querySelector('summary');

    // A tapped link may be a same-page anchor (e.g. `/#clients`), which does not
    // reload, then close the menu so the target is not left hidden behind it.
    menu.addEventListener('click', function (event) {
      if (event.target.closest('a')) menu.open = false;
    });

    document.addEventListener('click', function (event) {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });

    document.addEventListener('focusin', function (event) {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        if (summary) summary.focus();
      }
    });
  })();
</script>
