---
import { site, whatsappLink } from '../data/site';
import { dicts, localizePath, switchPath, type Locale } from '../i18n';

/**
 * Header with locale-aware navigation and a language switcher.
 *
 * The header is only rendered by `BaseLayout`, never by `DirectoryLayout` or
 * `AdminLayout`, so the switcher can never appear on `/sekolah` or `/admin`
 * pages — those layouts do not use this component at all.
 *
 * Desktop and mobile nav both exist in the markup and are toggled with
 * `hidden lg:flex` / `lg:hidden`, so exactly one is ever visible. Both use the
 * same `aria-label` for that reason.
 */
interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const d = dicts[locale];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: localizePath('/', locale), label: d.nav.home },
  { href: localizePath('/services', locale), label: d.nav.services },
  { href: localizePath('/portfolio', locale), label: d.nav.portfolio },
  { href: localizePath('/about', locale), label: d.nav.about },
  { href: localizePath('/articles', locale), label: d.nav.articles },
  { href: localizePath('/contact', locale), label: d.nav.contact },
];

const isCurrent = (href: string) => {
  const clean = href.replace(/\/$/, '') || '/';
  return clean === currentPath;
};

const switchTarget = switchPath(Astro.url.pathname);
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a
        href={localizePath('/', locale)}
        class="font-display flex items-baseline text-2xl font-black tracking-tight text-black"
      >
        Beresin<span class="text-brand-lime">.</span><span class="sr-only">Digital</span>
      </a>

      <nav class="hidden items-center gap-8 lg:flex" aria-label={d.nav.menuAria}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'text-sm font-bold transition-colors hover:text-black hover:underline hover:decoration-brand-lime hover:decoration-2 hover:underline-offset-4 hover:decoration-brand-lime-hover hover:decoration-brand-lime-hover hover:decoration-brand-lime-hover hover:decoration-brand-lime-hover hover:decoration-brand-lime-hover hover:decoration-brand-lime-hover',
                isCurrent(item.href) ? 'text-black underline decoration-brand-lime decoration-2 underline-offset-4' : 'text-gray-600',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-4 lg:flex">
        <nav class="flex items-center gap-1 text-sm font-bold" aria-label={d.switcher.ariaLabel}>
          {
            locale === 'id' ? (
              <>
                <span aria-current="true" class="text-black">ID</span>
                <span class="text-gray-300" aria-hidden="true">|</span>
                <a href={switchTarget} class="text-gray-500 hover:text-black">EN</a>
              </>
            ) : (
              <>
                <a href={switchTarget} class="text-gray-500 hover:text-black">ID</a>
                <span class="text-gray-300" aria-hidden="true">|</span>
                <span aria-current="true" class="text-black">EN</span>
              </>
            )
          }
        </nav>
        <a
          href="#consult"
          data-open-modal={d.modalSubjects.discussProject}
          class="rounded-full border-2 border-black bg-brand-lime px-4 py-2 text-sm font-black text-black shadow-[2px_2px_0px_#0D0F12] transition-colors hover:bg-brand-lime-hover"
        >
          {d.nav.getInTouch}
        </a>
      </div>

      <div class="flex items-center gap-2 lg:hidden">
        <nav class="flex items-center gap-1 text-sm font-bold" aria-label={d.switcher.ariaLabel}>
          {
            locale === 'id' ? (
              <>
                <span aria-current="true" class="text-black">ID</span>
                <span class="text-gray-300" aria-hidden="true">|</span>
                <a href={switchTarget} class="text-gray-500 hover:text-black">EN</a>
              </>
            ) : (
              <>
                <a href={switchTarget} class="text-gray-500 hover:text-black">ID</a>
                <span class="text-gray-300" aria-hidden="true">|</span>
                <span aria-current="true" class="text-black">EN</span>
              </>
            )
          }
        </nav>
        <button
          type="button"
          class="mobile-menu-button inline-flex items-center justify-center rounded-md p-2 text-gray-600 hover:bg-gray-100 hover:text-black"
          aria-label={d.nav.menuAria}
          aria-expanded="false"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav class="mobile-menu hidden border-t border-gray-200 bg-white px-4 py-4 lg:hidden" aria-label={d.nav.menuAria}>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'block rounded-lg px-3 py-2 text-base font-bold hover:bg-gray-100',
            isCurrent(item.href) ? 'bg-gray-100 text-black' : 'text-gray-600',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={whatsappLink(d.waMessages.discussProject)}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 block rounded-full border-2 border-black bg-brand-lime px-4 py-2 text-center text-sm font-black text-black"
    >
      {d.nav.chatWhatsapp}
    </a>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('.mobile-menu-button');
    var menu = document.querySelector('.mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', function () {
      var isOpen = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  })();
</script>
