# Build output
dist/
.astro/

# Lighthouse reports (local QA output, regenerated on demand)
.lighthouse/

# Dependencies
node_modules/

# Logs
*.log

# Environment
# Ignore every env variant (`.env.development`, `.env.staging`, …), not just the
# ones listed by hand — a forgotten variant is a committed credential. The
# example is the one file meant to be tracked.
.env
.env.*
!.env.example

# Local uploads (production lives at /srv/beresin/uploads).
# Root-anchored: a bare `uploads/` also matches `src/pages/uploads/`, the route
# that SERVES these files. That pattern silently ignored the route, so it was
# never committed and every deployed image 404'd its own uploads while the
# upload itself succeeded.
/uploads/

# Local runtime data (e.g. the contact-form NDJSON fallback when the DB is down)
.data/

# Local agent settings and source archives
/.codex/
/*.zip

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Test output
coverage/
lighthouse-report.*

# debug
preview/
design-reference/
