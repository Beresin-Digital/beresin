# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# On the server this file lives at /srv/beresin/.env with chmod 600.
# ---------------------------------------------------------------------------

# --- App ---
SITE_URL=https://beresindigital.id
HOST=0.0.0.0
PORT=4321

# --- Database ---
# ONE set of credentials. The Compose container reads these exact variables to
# create the role and the database, so there is a single source of truth and no
# way for the app and the container to disagree about a password.
#
# Local dev: the app runs on the host and Postgres is the Compose container, so
# the host is localhost and the port is 5433 (not 5432 — see docker-compose.yml).
# Production: point DB_HOST at the Postgres instance and use port 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=beresin
DB_USER=beresin
DB_PASSWORD=CHANGE_ME

# --- Sessions (Phase 3) ---
# At least 32 bytes of random data: `openssl rand -base64 32`
SESSION_SECRET=CHANGE_ME

# --- Email relay, Brevo (Phase 3) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@beresindigital.id
MAIL_TO=procurement@beresindigital.id

# --- Anti-spam (Phase 3) ---
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
# HMAC key for hashing submitter IPs. We never store raw IPs (UU PDP minimisation).
LEAD_IP_HMAC_SECRET=CHANGE_ME

# --- Analytics (Phase 5) ---
# Public: exposed to the browser. Empty = GA4 stays off entirely.
PUBLIC_GA4_ID=

# --- Uploads (Phase 3) ---
UPLOAD_DIR=/srv/beresin/uploads
