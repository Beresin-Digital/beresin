{
  "name": "beresin-digital",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/verify-directory-data.mjs && node scripts/prepare-directory.mjs && astro build && node scripts/verify-directory.mjs",
    "start": "node --env-file=.env dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-admin.mjs",
    "db:seed-content": "node scripts/seed-content.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:directory": "node scripts/verify-directory-data.mjs && node scripts/verify-directory.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@lucide/astro": "^1.52.0",
    "@node-rs/argon2": "^2.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.1.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
